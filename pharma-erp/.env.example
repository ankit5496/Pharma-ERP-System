# =============================================================================
# Pharma ERP â€” environment contract
# =============================================================================
# Copy to `.env` at the repo root:  cp .env.example .env
# Every variable below is REQUIRED unless marked OPTIONAL. Both apps validate
# their own variables on startup and exit non-zero if any are missing or
# malformed (fail fast â€” see apps/api/src/config/env.validation.ts and
# apps/web/src/lib/env.ts).
# -----------------------------------------------------------------------------

NODE_ENV=development

# -----------------------------------------------------------------------------
# Postgres â€” local Docker container (docker-compose.yml)
# -----------------------------------------------------------------------------
# These three feed docker-compose only. The superuser is used for migrations;
# the application never connects as it (superusers BYPASS Row-Level Security).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=pharma_erp
POSTGRES_PORT=5432

# The least-privilege application role created by docker/postgres/init/01-roles.sql.
# It is NOT a superuser and does NOT own the tables, so RLS is always enforced
# against it. Keep this in sync with the init script if you change it.
POSTGRES_APP_USER=pharma_app
POSTGRES_APP_PASSWORD=pharma_app_dev_password

# -----------------------------------------------------------------------------
# Database URLs
# -----------------------------------------------------------------------------
# DATABASE_URL â€” used by the running API (PrismaClient). Connects as the
# least-privilege app role so PostgreSQL RLS policies apply to every query.
#
# AGAINST A REMOTE DATABASE (Render, Neon, RDS) append:
#   ?sslmode=require&connection_limit=15&pool_timeout=20
#
# The connection limit matters more than it looks. Tenant scoping wraps EVERY
# operation in its own transaction so it can SET LOCAL app.current_tenant_id
# (see packages/database/src/tenant-scope.ts), so one query holds a connection
# for two round trips. A page issuing six parallel reads needs six connections
# for the duration, not one. A limit of 5 exhausted the pool against Render and
# failed with "Unable to start a transaction in the given time".
#
# Do not raise it carelessly on a SHARED database: the point is that several
# developers are on one instance, and one taking every connection starves the
# rest.
DATABASE_URL="postgresql://pharma_app:pharma_app_dev_password@localhost:5432/pharma_erp?schema=public"

# MIGRATION_DATABASE_URL â€” used by `prisma migrate` / `prisma studio` only
# (wired as `directUrl` in packages/database/prisma/schema.prisma). Needs DDL
# rights, so it connects as the superuser. Never use this at runtime.
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_erp?schema=public"

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000
# OPTIONAL â€” log level: error | warn | log | debug | verbose
LOG_LEVEL=log

# -----------------------------------------------------------------------------
# Web (Next.js)
# -----------------------------------------------------------------------------
# Base URL of the API as reachable from the browser AND from Next.js server
# components. Must NOT have a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only override of the API base URL, read at RUNTIME - so a change needs
# a restart, not a rebuild, unlike NEXT_PUBLIC_* which is inlined at build time.
# Takes precedence over NEXT_PUBLIC_API_URL when set.
#
# Only server components and server actions call the API; the browser never
# does, because the session cookie is forwarded server-side as a Bearer token.
# So the API does not need to be publicly reachable from the web service. On a
# host with a private network, using it keeps service-to-service traffic off
# the public internet - faster, and not subject to the edge rate limiting that
# otherwise answers 429 to your own web app.
#
# Must include a scheme; none is assumed, because a private address is plain
# http and silently upgrading it to https produces an unrecognisable error.
#   Render: http://<api-service-name>:<port>   e.g. http://pharma-erp-api:10000
# Leave unset locally.
# API_URL=

# -----------------------------------------------------------------------------
# Authentication (self-hosted â€” no external identity provider)
# -----------------------------------------------------------------------------
# HMAC key for signing access tokens. REQUIRED; at least 32 characters.
# A short key can be brute-forced offline from a single captured token, and
# forging a token means impersonating any user in any tenant. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing it invalidates every session immediately â€” that is the lever to pull
# if you ever need to sign everyone out at once.
JWT_SECRET=replace_me_with_48_random_bytes_base64url

# Session lifetime in seconds. Default 28800 (8 hours â€” one working shift, so an
# operator is not signed out mid-batch, and a stolen token expires the same day).
# There are no refresh tokens: the API re-reads the account from Postgres on
# every request, so disabling a user already takes effect immediately.
SESSION_TTL_SECONDS=28800

# There is NO public signup and NO social login. Accounts are provisioned:
#   1. You create a company and its first Admin:
#        pnpm create-tenant --name "Acme Pharma" --slug acme \
#                           --admin-email admin@acme.com --admin-name "..."
#   2. That Admin creates everyone else from /admin/users, assigning each a role.
# Both paths set a temporary password the user must replace on first sign-in.

