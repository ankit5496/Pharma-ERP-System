# =============================================================================
# .env.local  --  points the RUNNING API at the Render database
# =============================================================================
# Rename this file to `.env.local` once the values are filled in.
#
# WHY THIS FILE AND NOT .env:
#   apps/api/src/app.module.ts reads ['../../.env.local', '../../.env'] in that
#   order, so anything here wins for the running API.
#   Every Prisma CLI script is hardcoded to `dotenv -e ../../.env`, so
#   `pnpm db:migrate`, `db:reset`, `db:studio` and `db:seed` keep using the
#   LOCAL Docker database and cannot reach Render even by accident.
#
# NEVER add Render URLs to .env itself. That is the one change that would put
# `prisma migrate reset` one keystroke away from the shared database.
# =============================================================================

# The RUNTIME connection, as the least-privilege `pharma_app` role.
# Take the DATABASE_URL already set on the Render "Pharma-ERP" API service
# (Dashboard -> Pharma-ERP -> Environment), then replace its HOST with the
# External hostname from the database page -- the internal host does not
# resolve from your laptop.
#   postgresql://pharma_app:<password>@<external-host>/<db>?sslmode=require
DATABASE_URL="postgresql://pharma_app:REPLACE_ME@REPLACE_EXTERNAL_HOST/pharma_erp_main_db?sslmode=require"

# The OWNER connection. The API only uses this for tenant provisioning.
# Dashboard -> pharma-erp-main-db -> Connections -> External Database URL.
#
# It MUST differ from DATABASE_URL. If both are the owner, PostgreSQL RLS stops
# applying to the application and tenant isolation is silently gone --
# scripts/verify-rls.mjs refuses to run in that state, for this exact reason.
MIGRATION_DATABASE_URL="postgresql://REPLACE_OWNER_USER:REPLACE_ME@REPLACE_EXTERNAL_HOST/pharma_erp_main_db?sslmode=require"
