prisma:query SELECT "public"."purchase_requisitions"."id", "public"."purchase_requisitions"."item_id" FROM "public"."purchase_requisitions" WHERE ("public"."purchase_requisitions"."deleted_at" IS NULL AND "public"."purchase_requisitions"."status" IN (CAST($1::text AS "public"."RequisitionStatus"),CAST($2::text AS "public"."RequisitionStatus"))) OFFSET $3
prisma:query SELECT "public"."items"."id", "public"."items"."created_at", "public"."items"."code", "public"."items"."name", "public"."items"."type"::text, "public"."items"."uom", "public"."items"."shelf_life_months", "public"."items"."hsn_code", "public"."items"."brand_name", "public"."items"."generic_name", "public"."items"."schedule_classification"::text, "public"."items"."gst_rate", "public"."items"."mrp", "public"."items"."dpco_ceiling", "public"."items"."storage_conditions", "public"."items"."reorder_level", "public"."items"."reorder_quantity", "public"."items"."requires_batch_tracking", "public"."items"."notes" FROM "public"."items" WHERE ("public"."items"."deleted_at" IS NULL AND "public"."items"."type" IN (CAST($1::text AS "public"."ItemType"),CAST($2::text AS "public"."ItemType"),CAST($3::text AS "public"."ItemType"))) ORDER BY "public"."items"."name" ASC OFFSET $4
prisma:query SELECT SUM("public"."stock_lots"."quantity_available") AS "_sum$quantity_available", "public"."stock_lots"."item_id" FROM "public"."stock_lots" WHERE "public"."stock_lots"."status" = CAST($1::text AS "public"."StockLotStatus") GROUP BY "public"."stock_lots"."item_id" OFFSET $2
prisma:query SELECT SUM("public"."stock_lots"."quantity_available") AS "_sum$quantity_available", "public"."stock_lots"."item_id" FROM "public"."stock_lots" WHERE "public"."stock_lots"."status" = CAST($1::text AS "public"."StockLotStatus") GROUP BY "public"."stock_lots"."item_id" OFFSET $2
prisma:query COMMIT
prisma:query SELECT "public"."purchase_order_lines"."id", "public"."purchase_order_lines"."item_id", "public"."purchase_order_lines"."quantity", "public"."purchase_order_lines"."quantity_received", "public"."purchase_order_lines"."quantity_cancelled" FROM "public"."purchase_order_lines" LEFT JOIN "public"."purchase_orders" AS "j0" ON ("j0"."id") = ("public"."purchase_order_lines"."purchase_order_id") WHERE ("j0"."deleted_at" IS NULL AND "j0"."status" NOT IN (CAST($1::text AS "public"."PurchaseOrderStatus"),CAST($2::text AS "public"."PurchaseOrderStatus")) AND ("j0"."id" IS NOT NULL)) OFFSET $3
prisma:query COMMIT
