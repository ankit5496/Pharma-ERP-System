// =============================================================================
// Pharma ERP — Prisma schema
// =============================================================================
// Scope of this file today: the tenant layer (Tenant, User, AuditLog), and the
// platform layer (PlatformUser, PlatformAuditLog) that sits outside it. The
// domain (Item, Party, Bom, Batch, purchase/production/sales) lands
// incrementally, flow by flow.
//
// Two rules apply to every model added from here on:
//
//   1. TENANT SCOPING — every tenant-scoped table carries `tenantId` (UUID) and
//      gets a Row-Level Security policy in a raw-SQL migration. Prisma-level
//      `where: { tenantId }` filters are a second layer, never the only one.
//   2. NO HARD DELETES on compliance-relevant tables — carry `deletedAt` and
//      filter it out in queries. AuditLog is stricter still: append-only,
//      enforced by a database trigger.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // Default output (node_modules/.prisma/client, surfaced as '@prisma/client').
  // A custom output directory would force this package's compiled .d.ts to
  // reference a relative path that does not exist inside dist/, so consumers
  // would silently lose every generated type.
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: the least-privilege `pharma_app` role, so RLS applies.
  url       = env("DATABASE_URL")
  // Migrations / Studio: the superuser, which needs DDL rights. Prisma uses
  // `directUrl` for migrate + introspect + studio and `url` for the client.
  directUrl = env("MIGRATION_DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Mirrors USER_ROLES in packages/types/src/roles.ts. A compile-time assertion
/// in src/index.ts fails the build if the two lists ever diverge.
enum UserRole {
  ADMIN
  PURCHASE_MANAGER
  STORE_OFFICER
  PRODUCTION_OFFICER
  QUALITY_OFFICER
  SALES_MANAGER
  ACCOUNTANT
  MANAGEMENT
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Mutations recorded in the audit trail.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
}

// -----------------------------------------------------------------------------
// Tenant — the root of the multi-tenancy tree
// -----------------------------------------------------------------------------

/// One pharma manufacturing company. This is the ONLY model without a
/// `tenantId` column, because its own `id` IS the tenant id; its RLS policy
/// compares `id` against the session's current tenant instead.
model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  /// URL-safe identifier used for tenant-specific routes and subdomains.
  slug String @unique @db.VarChar(63)
  name String @db.VarChar(255)

  status TenantStatus @default(TRIAL)

  /// Manufacturing licence number issued by the state FDA / drug controller.
  /// Nullable during onboarding; required before a batch can be released.
  drugLicenceNumber String? @map("drug_licence_number") @db.VarChar(64)
  gstin             String? @db.VarChar(15)
  /// IANA zone (e.g. "Asia/Kolkata"). Batch and expiry dates are legally
  /// meaningful, so they are rendered in the tenant's own zone, not the server's.
  timezone          String  @default("Asia/Kolkata") @db.VarChar(64)

  /// How far a vendor's invoice may depart from the receipt before the match
  /// is flagged, as a percentage of quantity or rate.
  ///
  /// Configurable per company because the right number is a commercial
  /// decision, not a technical one: a business buying commodity solvents at a
  /// quoted index price expects small variance, one buying on fixed contracts
  /// expects none. 2% is a conventional starting point, not a recommendation.
  invoiceTolerancePercent Decimal @default(2.00) @map("invoice_tolerance_percent") @db.Decimal(5, 2)

  /// How many days before a licence expires the dashboard starts warning about
  /// it (US-MD-04).
  ///
  /// A column rather than a constant because the criterion says "configurable",
  /// and because the right number is a commercial decision like the tolerance
  /// above: a state FDA that takes three months to renew a manufacturing
  /// licence needs more warning than a GST registration renewed online in a
  /// day. 60 is the specified default, not a recommendation.
  licenceAlertLeadDays Int @default(60) @map("licence_alert_lead_days")

  /// Whether the reorder check may raise requisitions by itself.
  ///
  /// TRUE BY DEFAULT, which is the behaviour every tenant had before the
  /// switch existed. Turned off, the check still reports what it would have
  /// raised — knowing an item is short is useful whether or not the system is
  /// allowed to act on it — but creates nothing, and requisitions are raised
  /// by hand instead.
  autoRequisitionEnabled Boolean @default(true) @map("auto_requisition_enabled")

  /// The leading part of a batch number, e.g. "B" in "B-2609-001" (US-PROD-03).
  ///
  /// The criterion is that a batch number follows the COMPANY'S configured
  /// convention, so the part a company would want to choose is a column. The
  /// rest of the shape — year, month, zero-padded counter — is fixed, because a
  /// free-form format string is a way to configure two companies into the same
  /// number.
  batchNumberPrefix String @default("B") @map("batch_number_prefix") @db.VarChar(8)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete. A tenant is never physically removed — its records are
  /// retained for the statutory retention period.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  users     User[]
  auditLogs AuditLog[]

  // Master data, shared by both flows.
  items    Item[]
  parties  Party[]
  licences Licence[]

  /// Customer paperwork; the bytes live in the row. See CustomerDocument.
  customerDocuments CustomerDocument[]

  // Job-work: manufacturing under a principal's brand.
  jobWorkAgreements      JobWorkAgreement[]
  jobWorkProductMappings JobWorkProductMapping[]

  // Packaging: what each pack presentation consumes.
  packagingRequirements     PackagingRequirement[]
  packagingRequirementLines PackagingRequirementLine[]

  // Procure-to-Pay. Every one of these tables carries `tenantId` with a real
  // foreign key, so a row cannot reference a company that does not exist. The
  // back-relations are required by Prisma to declare that side; nothing reads
  // a whole tenant's purchase orders through this collection.
  documentSequences    DocumentSequence[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceipts        GoodsReceipt[]
  goodsReceiptLines    GoodsReceiptLine[]
  stockLots            StockLot[]
  qcResults            QcResult[]
  stockLedgerEntries   StockLedgerEntry[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  vendorPayments       VendorPayment[]
  boms                 Bom[]
  bomLines             BomLine[]
  productionPlans      ProductionPlan[]

  // Production & Quality Gate. `boms` and `bomLines` are not repeated here:
  // formulations are master data, shared with Procure-to-Pay, and declared
  // once in the block above.
  productionOrders   ProductionOrder[]
  materialIssues     MaterialIssue[]
  materialIssueLines MaterialIssueLine[]
  batches            Batch[]
  packingRecords     BatchPackingRecord[]
  packagingConsumptions BatchPackagingConsumption[]
  finishedGoodsLots  FinishedGoodsLot[]
  customerLicences   CustomerLicence[]
  salesOrders        SalesOrder[]
  salesOrderItems    SalesOrderItem[]
  batchAllocations   BatchAllocation[]
  dispatches         Dispatch[]
  dispatchItems      DispatchItem[]
  salesInvoices      SalesInvoice[]
  salesInvoiceItems  SalesInvoiceItem[]
  receipts           Receipt[]
  salesReturns       SalesReturn[]
  salesReturnItems   SalesReturnItem[]
  receivableEntries  ReceivableLedgerEntry[]

  @@index([deletedAt])
  @@map("tenants")
}

// -----------------------------------------------------------------------------
// User
// -----------------------------------------------------------------------------

/// A person who signs in, belonging to exactly one Tenant.
///
/// The tenant is assigned by whoever creates the account — an Admin creating a
/// colleague, or the platform creating a company's first Admin — and is never
/// supplied by a client request. Platform staff are NOT in this table; see
/// PlatformUser.
model User {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Login identifier. Globally unique, not per-tenant: sign-in takes only an
  /// email and a password, so it has to identify exactly one account. The cost
  /// is that one address cannot hold accounts at two companies — acceptable for
  /// a closed, admin-provisioned system, and the alternative (asking for a
  /// company alongside the email at every login) is worse for the far more
  /// common case. Always stored lowercased; see the citext-style constraint in
  /// the migration.
  email    String  @unique @db.VarChar(320)
  fullName String  @map("full_name") @db.VarChar(255)
  phone    String? @db.VarChar(32)

  role   UserRole
  /// INVITED = created but no password set, cannot sign in.
  /// ACTIVE  = can sign in. DISABLED = revoked by an administrator.
  status UserStatus @default(INVITED)

  // ---------------------------------------------------------------------------
  // Credentials
  // ---------------------------------------------------------------------------

  /// argon2id hash. Null while the account is INVITED. Never leaves the API —
  /// every read of this model for response purposes uses an explicit `select`.
  passwordHash String? @map("password_hash") @db.VarChar(255)

  /// When the current password was set. Feeds password-age reporting, which
  /// 21 CFR Part 11 §11.300(b) expects to be evidenced.
  passwordSetAt DateTime? @map("password_set_at") @db.Timestamptz(6)

  /// Set when an Admin creates the account or resets the password. While true,
  /// every route except change-password is refused — an admin-chosen password
  /// is a shared secret until the user replaces it.
  mustChangePassword Boolean @default(true) @map("must_change_password")

  /// Consecutive failed sign-ins; reset to 0 on success. Drives lockedUntil.
  failedLoginAttempts Int @default(0) @map("failed_login_attempts")

  /// Sign-in is refused until this passes. Throttles online password guessing
  /// without an admin having to intervene.
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  auditLogs AuditLog[]

  /// Who uploaded a customer's document, for the audit trail.
  customerDocumentsUploaded CustomerDocument[]

  productionOrdersCreated ProductionOrder[]    @relation("ProductionOrderCreatedBy")
  materialIssuesMade      MaterialIssue[]      @relation("MaterialIssueIssuedBy")
  packingRecordsMade      BatchPackingRecord[] @relation("BatchPackingRecordedBy")
  batchReleaseDecisions   Batch[]              @relation("BatchReleaseDecidedBy")
  salesOrdersCreated      SalesOrder[]
  allocationsMade         BatchAllocation[]    @relation("AllocationAllocatedBy")
  allocationChecksMade    BatchAllocation[]    @relation("AllocationComplianceCheckedBy")
  dispatchesCreated       Dispatch[]           @relation("DispatchCreatedBy")
  invoicesCreated         SalesInvoice[]       @relation("InvoiceCreatedBy")
  receiptsCreated         Receipt[]            @relation("ReceiptCreatedBy")
  salesReturnsCreated     SalesReturn[]        @relation("ReturnCreatedBy")
  ledgerEntriesCreated    ReceivableLedgerEntry[] @relation("LedgerCreatedBy")

  /// Retained alongside the global unique on `email` so a tenant's user list
  /// can be scanned by address without touching the global index.
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([tenantId, deletedAt])
  @@map("users")
}

// -----------------------------------------------------------------------------
// AuditLog
// -----------------------------------------------------------------------------

/// Append-only trail written automatically by the API's audit interceptor.
///
/// Append-only is enforced in two places: the API never exposes update/delete,
/// and a database trigger (see the RLS migration) raises an exception on any
/// UPDATE or DELETE. There is deliberately no `deletedAt` column — a row that
/// could be marked deleted would not be an audit trail.
model AuditLog {
  id       BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid

  /// Prisma model name of the audited entity, e.g. "Batch".
  entityType String      @map("entity_type") @db.VarChar(64)
  /// Primary key of the audited row, stringified (keys are not all UUIDs).
  entityId   String      @map("entity_id") @db.VarChar(64)
  action     AuditAction

  /// Acting user. Null for system/background writes (migrations, jobs).
  userId     String? @map("user_id") @db.Uuid
  /// Snapshot of the row before the change; null on CREATE.
  beforeJson Json?   @map("before_json")
  /// Snapshot of the row after the change; null on DELETE.
  afterJson  Json?   @map("after_json")

  /// Request correlation id, for tying an audit entry back to API logs.
  requestId String? @map("request_id") @db.VarChar(64)
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// The access pattern that matters: "what happened to this record".
  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// Production & Quality Gate
// =============================================================================
// Workflow 2: plan a batch, issue material against its formulation, record what
// was actually made, and put it through the quality gate that decides whether it
// may ever be sold.
//
// Two rules from the top of this file apply throughout and are not repeated on
// every model: each table carries `tenantId` and gets an RLS policy in the
// accompanying raw-SQL migration, and nothing compliance-relevant is hard
// deleted.
//
// A third rule is specific to this section: QUANTITIES ARE Decimal(14,3),
// never Float. A binary float cannot represent 0.1, and a rounding drift in a
// dispensed quantity is a regulatory finding, not a cosmetic bug.
// -----------------------------------------------------------------------------

/// Which side of the business a party sits on.
///
/// These three values are NOT ours to choose — the `parties` table and this
/// enum were created by the Procure-to-Pay work, whose migrations live on the
/// shared database rather than in this repository. Purchase orders already
/// filter on `VENDOR`, so adding a fourth value here (a "both" case) would
/// silently hide such a party from their vendor picker. If a party genuinely
/// buys and sells, that needs agreeing with whoever owns P2P.
enum PartyType {
  VENDOR
  CUSTOMER
  JOB_WORK_PRINCIPAL
}

/// What kind of buyer this is. Drives nothing on its own today; it is what the
/// sales desk filters and reports by.
enum CustomerType {
  DISTRIBUTOR
  STOCKIST
  WHOLESALER
  RETAIL_CHAIN
  HOSPITAL
  GOVERNMENT
  EXPORT
  OTHER
}

enum CustomerLicenceCategory {
  RETAIL
  WHOLESALE
  MANUFACTURING
  OTHER
}

/// The licence's REGULATORY STANDING, not its freshness. Whether it is still in
/// date is derived from expiryDate at read time; this records whether the
/// authority has suspended or cancelled it. A licence can be well inside its
/// validity window and still be SUSPENDED.
enum CustomerLicenceStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// Whether a party may be transacted with. A CUSTOMER may only be ACTIVE
/// when its drug licence number and validity are on file — enforced by the
/// `parties_active_customer_is_licensed` CHECK constraint, not only here.
enum PartyStatus {
  ACTIVE
  INACTIVE
  /// A commercial hold — credit stopped, licence lapsed — distinct from
  /// INACTIVE, which means the account is simply not in use. The order gate
  /// treats them differently, so they cannot collapse into one value.
  BLOCKED
}

/// Where a work order has reached. Ordered as the process runs.
enum ProductionOrderStatus {
  PLANNED
  MATERIAL_ISSUED
  IN_PROGRESS
  PACKED
  UNDER_TEST
  CLOSED
  CANCELLED
}

/// The quality gate's verdict, and the most consequential field in this
/// section: RELEASED is what creates sellable stock, and BLOCKED is permanent.
enum BatchReleaseStatus {
  PENDING
  RELEASED
  BLOCKED
}

// -----------------------------------------------------------------------------
// Item
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// Party — suppliers and customers in one register
// -----------------------------------------------------------------------------
// One table rather than two, because a great many parties are both: a
// distributor that also supplies cartons is one legal entity with one GSTIN,
// and two records for it is how the two copies of its address start to
// disagree. `type` says which side it acts on.
//
// The customer fields are nullable here and constrained in SQL: a party may
// only be an ACTIVE customer once its drug licence number and validity are on
// file. That is a CHECK constraint in the migration, not just a service rule,
// because selling to an unlicensed buyer is the kind of thing that has to be
// impossible rather than merely discouraged.

// -----------------------------------------------------------------------------
// Stock: see StockLot, above
// -----------------------------------------------------------------------------
//
// Production once had its own `material_lots` table here. It was dropped by
// 20260914120000_drop_material_lots: a goods receipt writes a StockLot and
// incoming QC releases it, and no request path ever wrote the other one. FEFO
// allocates from StockLot — the lot a batch consumed is the lot a vendor
// delivered, which is what makes a recall answerable in both directions.


// -----------------------------------------------------------------------------
// Bom — the formulation
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// ProductionOrder — the work order
// -----------------------------------------------------------------------------

/// An instruction to make a stated quantity of a product to a stated
/// formulation version. The root record of everything that follows.
model ProductionOrder {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  orderNumber String @map("order_number") @db.VarChar(32)

  productId String @map("product_id") @db.Uuid
  /// Pinned at creation. If the formulation is superseded mid-batch, this order
  /// still points at the version its material was issued against.
  bomId     String @map("bom_id") @db.Uuid

  plannedQuantity Decimal   @map("planned_quantity") @db.Decimal(14, 3)
  plannedStartOn  DateTime? @map("planned_start_on") @db.Date

  status ProductionOrderStatus @default(PLANNED)

  createdById String?   @map("created_by_id") @db.Uuid
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product   Item   @relation(fields: [productId], references: [id], onDelete: Restrict)
  bom       Bom    @relation(fields: [bomId], references: [id], onDelete: Restrict)
  createdBy User?  @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  issues  MaterialIssue[]
  batches Batch[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, deletedAt])
  @@map("production_orders")
}

// -----------------------------------------------------------------------------
// MaterialIssue — dispensing to the shop floor
// -----------------------------------------------------------------------------

/// One dispensing event against a work order.
///
/// Header/line rather than a single flat table because one issue draws from
/// several lots — that is the normal case, not the exception: a required
/// quantity routinely spans two lots when the earliest-expiring one runs short.
model MaterialIssue {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  productionOrderId String @map("production_order_id") @db.Uuid

  issuedAt   DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedById String?  @map("issued_by_id") @db.Uuid

  notes String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  issuedBy        User?           @relation("MaterialIssueIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)

  lines MaterialIssueLine[]

  @@index([tenantId, productionOrderId])
  @@map("material_issues")
}

/// One lot consumed by one issue. This row IS the traceability link: given a
/// finished batch, these rows answer "which supplier lots went into it", and
/// given a recalled supplier lot, they answer "which batches are affected".
model MaterialIssueLine {
  id              String @id @default(uuid()) @db.Uuid
  /// Present for the same reason as on BomLine: the tenant-scoping invariant is
  /// a column plus a policy on every table, not an inherited property.
  tenantId        String @map("tenant_id") @db.Uuid
  materialIssueId String @map("material_issue_id") @db.Uuid
  itemId          String @map("item_id") @db.Uuid

  /// The stock lot the material came out of.
  ///
  /// StockLot, and now the only one. Production and Procure-to-Pay each
  /// modelled their own stock table, and only one of them was ever filled by
  /// the application: a goods receipt creates a StockLot and incoming QC marks
  /// it USABLE. The other, `material_lots`, was populated by the demo seeder
  /// alone — issuing from it meant allocating against stock that no real
  /// receipt had produced — and was dropped by
  /// 20260914120000_drop_material_lots. One table, and it is the one the
  /// warehouse actually puts things in.
  lotId           String @map("lot_id") @db.Uuid

  quantityIssued Decimal @map("quantity_issued") @db.Decimal(14, 3)

  /// US-PROD-02: FEFO is the default, and departing from it is recorded.
  ///
  /// The criterion is that the screen always PROPOSES the nearest-expiry lot;
  /// it does not forbid picking another one, because a physically damaged or
  /// quarantined-on-the-shelf container is a real thing. What it cannot be is
  /// silent — so an override carries a written reason, and the CHECK constraint
  /// makes a reasonless override impossible rather than merely discouraged.
  isFefoOverride Boolean @default(false) @map("is_fefo_override")
  overrideReason String? @map("override_reason") @db.VarChar(500)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  materialIssue MaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot           StockLot      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([materialIssueId])
  /// Answers a recall from the supplier's side.
  @@index([lotId])
  @@map("material_issue_lines")
}

// -----------------------------------------------------------------------------
// Batch — the Batch Manufacturing Record
// -----------------------------------------------------------------------------

/// A physical batch, and the record of what was actually made.
///
/// Carries the release decision because that decision is a property of the
/// batch, not of a separate approval document: one row, one flag, one answer to
/// "may this be sold". Splitting it across tables would allow the two to
/// disagree.
model Batch {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @map("tenant_id") @db.Uuid
  productionOrderId String @map("production_order_id") @db.Uuid

  batchNumber String @map("batch_number") @db.VarChar(32)

  manufacturedOn DateTime @map("manufactured_on") @db.Date
  /// Derived from the product's shelfLifeMonths at creation, then fixed. It is
  /// printed on the carton, so it must not silently change if the master data
  /// is later corrected.
  expiryDate     DateTime @map("expiry_date") @db.Date

  plannedQuantity Decimal  @map("planned_quantity") @db.Decimal(14, 3)
  /// Yield. Null until manufacture is recorded.
  actualQuantity  Decimal? @map("actual_quantity") @db.Decimal(14, 3)

  // ---------------------------------------------------------------------------
  // The quality gate
  // ---------------------------------------------------------------------------

  releaseStatus      BatchReleaseStatus @default(PENDING) @map("release_status")
  releaseDecidedAt   DateTime?          @map("release_decided_at") @db.Timestamptz(6)
  releaseDecidedById String?            @map("release_decided_by_id") @db.Uuid
  /// Why. Required for BLOCKED by the service — a batch destroyed without a
  /// recorded reason is exactly what an inspector asks about.
  releaseNotes       String?            @map("release_notes") @db.Text

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  productionOrder  ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Restrict)
  releaseDecidedBy User?           @relation("BatchReleaseDecidedBy", fields: [releaseDecidedById], references: [id], onDelete: Restrict)

  packingRecord    BatchPackingRecord?
  finishedGoodsLot FinishedGoodsLot?

  allocations       BatchAllocation[]
  salesInvoiceItems SalesInvoiceItem[]
  salesReturnItems  SalesReturnItem[]

  @@unique([tenantId, batchNumber])
  @@index([tenantId, releaseStatus, deletedAt])
  @@map("batches")
}

// -----------------------------------------------------------------------------
// BatchPackingRecord — the BPR
// -----------------------------------------------------------------------------

/// What came out of packing. Separate from Batch because manufacturing and
/// packing are separate signed operations in a pharma plant, often on different
/// days and by different people.
model BatchPackingRecord {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  batchId  String @unique @map("batch_id") @db.Uuid

  /// Saleable units packed. This — not the manufactured yield — is what becomes
  /// finished-goods stock on release.
  packedQuantity Decimal  @map("packed_quantity") @db.Decimal(14, 3)

  /// Units damaged or discarded on the packing line (US-PROD-04).
  ///
  /// Separate from packedQuantity because the two answer different questions:
  /// what can be sold, and what the batch cost to pack. Their SUM is what has
  /// to reconcile against the bulk yield — packed alone always would, by
  /// leaving the losses out.
  rejectedQuantity Decimal @default(0) @map("rejected_quantity") @db.Decimal(14, 3)

  /// Which presentation was packed, e.g. "10 x 10 blister carton".
  ///
  /// Matches PackagingRequirement.packVariant, which is how the line knows what
  /// components this pack consumes. Nullable because a batch packed before any
  /// pack specification existed still has a record.
  packVariant String? @map("pack_variant") @db.VarChar(128)

  packedOn       DateTime @map("packed_on") @db.Date

  recordedById String? @map("recorded_by_id") @db.Uuid
  notes        String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batch      Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recordedBy User?  @relation("BatchPackingRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  consumptions BatchPackagingConsumption[]

  @@index([tenantId])
  @@map("batch_packing_records")
}

/// One packaging component consumed by a batch (US-PROD-04).
///
/// "Officer records the consumption of packaging materials (bottles, foils,
/// cartons) against the specific batch." Recorded per component rather than as
/// a single number, because a shortage is answered per component and a recall
/// asks which carton lot went onto which batch.
///
/// What was EXPECTED comes from the Packaging Requirement Master, scaled to the
/// packed quantity; this table records what was actually used. The two differ
/// in normal operation — that difference is packing wastage — so the expected
/// figure is computed, never stored here.
model BatchPackagingConsumption {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  packingRecordId String @map("packing_record_id") @db.Uuid

  /// The packing material. An Item of type PACKING_MATERIAL, checked by the
  /// service — a CHECK constraint cannot read another table.
  itemId String @map("item_id") @db.Uuid

  quantityConsumed Decimal @map("quantity_consumed") @db.Decimal(14, 3)

  /// The stock lot it came out of, where the line recorded one. Nullable
  /// because packing material is not always lot-tracked, and a recall that
  /// cannot name the carton lot is still better than no record of the carton.
  lotId String? @map("lot_id") @db.Uuid

  notes String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  packingRecord BatchPackingRecord @relation(fields: [packingRecordId], references: [id], onDelete: Cascade)
  item          Item               @relation("BatchPackagingComponent", fields: [itemId], references: [id], onDelete: Restrict)
  lot           StockLot?          @relation(fields: [lotId], references: [id], onDelete: Restrict)

  /// One line per component per packing record.
  @@unique([packingRecordId, itemId])
  @@index([tenantId, itemId])
  @@map("batch_packaging_consumptions")
}

// -----------------------------------------------------------------------------
// FinishedGoodsLot — sellable stock
// -----------------------------------------------------------------------------

/// Finished stock available to sell. A row here exists ONLY because a batch was
/// released.
///
/// That is the whole design: "may this be sold" is answered by whether a lot
/// exists, not by reading a status flag on the way past. A blocked batch has no
/// row, so no sales order or job-work despatch can reach it even if a future
/// query forgets to filter on release status.
model FinishedGoodsLot {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  batchId  String @unique @map("batch_id") @db.Uuid
  itemId   String @map("item_id") @db.Uuid

  quantityAvailable Decimal  @map("quantity_available") @db.Decimal(14, 3)
  /// Copied from the batch so the FEFO index lives on this table alone.
  expiryDate        DateTime @map("expiry_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  batch  Batch  @relation(fields: [batchId], references: [id], onDelete: Restrict)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// FEFO for despatch, mirroring the index on stock_lots.
  @@index([tenantId, itemId, expiryDate])
  @@map("finished_goods_lots")
}

// -----------------------------------------------------------------------------
// Platform layer — deliberately OUTSIDE the tenant model
// -----------------------------------------------------------------------------

/// A platform operator: the vendor's own staff, who create customer companies
/// and their first Admin.
///
/// A separate table from `User` rather than a SUPER_ADMIN role, for one decisive
/// reason: an Admin must never see platform staff in their user management. With
/// a separate table that is true structurally — the Admin's queries run against
/// `users` and cannot reach here — instead of depending on every future query
/// remembering to filter a role out. It also keeps `users.tenant_id` NOT NULL,
/// which every RLS policy in this database relies on.
///
/// Not tenant-scoped, so it has no RLS policies. Isolation comes from
/// privileges instead: the runtime role `pharma_app` is REVOKEd on this table
/// entirely, so a request-scoped connection gets "permission denied" rather than
/// an empty result. Only the provisioning connection can read or write it.
model PlatformUser {
  id String @id @default(uuid()) @db.Uuid

  email    String  @unique @db.VarChar(320)
  fullName String  @map("full_name") @db.VarChar(255)
  phone    String? @db.VarChar(32)

  status PlatformUserStatus @default(ACTIVE)

  /// argon2id hash. Same policy and parameters as tenant users.
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  passwordSetAt      DateTime? @map("password_set_at") @db.Timestamptz(6)
  mustChangePassword Boolean   @default(true) @map("must_change_password")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  auditLogs PlatformAuditLog[]

  @@index([deletedAt])
  @@map("platform_users")
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

/// Append-only trail for platform-level actions: a Super User signing in,
/// creating a company, suspending one.
///
/// Separate from `AuditLog` because that table's `tenant_id` is NOT NULL and
/// its policies are tenant-scoped — correct for tenant activity, but a Super
/// User signing in belongs to no tenant. Widening `AuditLog` would have meant
/// making the column nullable and loosening every policy that depends on it.
model PlatformAuditLog {
  id BigInt @id @default(autoincrement())

  /// Acting platform user. Null for the CLI, which has no session — honest
  /// attribution beats inventing one.
  platformUserId String? @map("platform_user_id") @db.Uuid

  action     String  @db.VarChar(64)
  entityType String  @map("entity_type") @db.VarChar(64)
  entityId   String? @map("entity_id") @db.VarChar(64)

  /// Snapshot of what changed. Never contains credentials.
  detailsJson Json? @map("details_json")

  requestId String? @map("request_id") @db.VarChar(64)
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([platformUserId, createdAt])
  @@map("platform_audit_logs")
}

// =============================================================================
// Procure-to-Pay
// =============================================================================
// Buying raw materials: low stock -> requisition -> purchase order -> goods
// receipt -> incoming QC -> usable inventory -> invoice -> payable -> payment.
//
// Three decisions run through every model below, stated once here:
//
//   1. QUANTITIES AND MONEY ARE DECIMAL, never Float. A binary float cannot
//      represent 0.1, and a dispensing quantity or an invoice total that is
//      wrong in the fourth decimal place is a regulatory problem, not a
//      rounding curiosity. Prisma surfaces these as Decimal.js and the API
//      serialises them as strings, so no value passes through a JS number.
//
//   2. STOCK IS DERIVED, NEVER STORED ON THE ITEM. "Available stock" is the
//      sum of its USABLE lots. A denormalised counter on Item would be one
//      missed decrement away from telling a Production Officer that material
//      exists when it does not, and nothing would reveal it had drifted. The
//      cost is an aggregate per read; correctness wins.
//
//   3. USER ATTRIBUTION IS A UUID COLUMN, NOT A RELATION. `requestedById`,
//      `createdById` and friends carry no Prisma relation: eight named
//      back-relation arrays on User would make that model unreadable, and
//      nobody navigates "all requisitions raised by this person" from the user
//      side. Integrity still holds because users are soft-deleted only -- the
//      prevent_hard_delete trigger means a referenced id cannot vanish.
// =============================================================================

/// Item categories, as defined on the shared database. PACKING_MATERIAL and
/// SEMI_FINISHED are Render's vocabulary, not this repo's earlier PACKAGING —
/// the shared schema is authoritative and the code follows it.
enum ItemType {
  RAW_MATERIAL
  PACKING_MATERIAL
  SEMI_FINISHED
  FINISHED_GOOD
}

/// Drugs and Cosmetics Rules schedule. Decides prescription and record-keeping
/// obligations; H1 in particular requires a separate register of supply.
enum ScheduleClassification {
  NONE
  H
  H1
  X
  G
}

/// What a component's stated quantity is counted against (US-MD-06).
///
/// PER_PACK scales with the number of packs a batch yields — cartons, foil,
/// labels. PER_BATCH does NOT scale: one batch record insert is one whether the
/// batch is ten thousand tablets or a million.
enum PackagingQuantityBasis {
  PER_PACK
  PER_BATCH
}

/// Whether packing may proceed without this component (US-MD-06).
///
/// The field that does the real work in the shortage check. Short of a carton,
/// the line stops; short of an outer shipper, it can usually run and be shipped
/// later. Recording which is which is what lets the system block one and merely
/// warn on the other.
enum PackagingComponentRequirement {
  MANDATORY
  OPTIONAL
}

/// How a job-work principal is billed (US-MD-05).
///
/// The most consequential field on an agreement: it decides whose material is
/// consumed and what the invoice is raised on. Under OWN_PROCUREMENT we buy the
/// materials and bill the finished goods; under PURE_CONVERSION the principal
/// supplies the materials and we bill only the conversion.
///
/// Mandatory on the agreement, and — once the Production module carries it —
/// frozen on any order that has left PLANNED. See the note on
/// JobWorkAgreement.billingModel.
enum BillingModel {
  OWN_PROCUREMENT
  PURE_CONVERSION
}

/// What a conversion charge is charged per.
///
/// Stored beside the rate because a rate without a basis is a number nobody can
/// interpret six months later — "₹4.50" is meaningless until you know whether
/// that is per pack or per thousand units.
enum ConversionRateBasis {
  PER_BATCH
  PER_1000_UNITS
  PER_PACK
  PER_KG
}

/// The statutory permissions a manufacturer holds, each with its own issuing
/// authority and renewal cycle (US-MD-04).
///
/// Kept deliberately short — these three are what the register was specified
/// with. Adding a value is a one-line migration, and inventing categories
/// nobody asked for would put empty dropdown entries in front of whoever files
/// the paperwork.
enum LicenceType {
  MANUFACTURING
  GST_REGISTRATION
  NARCOTICS
}

/// Lifecycle of a purchase requisition.
///
/// OPEN covers everything before approval — whether the system raised it from
/// a reorder level or a Store Officer typed it. An earlier draft/pending split
/// existed here and was collapsed: nobody could say what distinguished them,
/// and two states that behave identically are two chances to filter wrongly.
enum RequisitionStatus {
  OPEN
  APPROVED
  CONVERTED_TO_PO
  CANCELLED
}

/// Why a requisition exists.
///
/// AUTO_REORDER is raised by the system when usable stock crosses the item's
/// reorder level; MANUAL is raised by a person, normally against a production
/// plan. The distinction is worth storing rather than inferring from whether
/// `requestedById` is null: it decides which fields are required, and a buyer
/// reviewing the queue treats the two differently.
/// Where a component sits in the pack: the blister that touches the tablet,
/// the carton around it, the shipper around that.
///
/// An enum rather than a master table — the three levels are a property of
/// packaging itself, not something a company configures.
///
/// The distinction is regulatory as much as practical: primary packaging
/// touches the medicine and is part of the product's stability data, so
/// substituting it is a change control. A shipper is not.
///
/// Shared by two models that arrived independently — PurchaseRequisition
/// (Procure-to-Pay) and PackagingRequirementLine (US-MD-06). One definition,
/// because they mean the same thing and the database has one type.
enum PackagingLevel {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum RequisitionTriggerType {
  AUTO_REORDER
  MANUAL
}

enum ProductionPlanStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Lifecycle of a purchase order, as US-PUR-02 defines it.
///
/// Three working states, all driven by goods receipts rather than chosen by a
/// user: an order is OPEN from the moment it is raised, PARTIALLY_RECEIVED
/// once some of it arrives, CLOSED once all of it has. Nobody sets these by
/// hand — an order that claims to be received when nothing arrived is exactly
/// what that removes.
enum PurchaseOrderStatus {
  OPEN
  PARTIALLY_RECEIVED
  CLOSED
  CANCELLED
}

/// The incoming-QC decision, and by extension whether a lot may be used.
///
/// ON_HOLD is distinct from REJECTED on purpose: both keep material out of
/// production, but a hold is reversible after investigation and a rejection
/// heads to a vendor return. Collapsing them would lose the difference between
/// "not yet cleared" and "will never be cleared".
enum QcDecision {
  ACCEPTED
  REJECTED
  ON_HOLD
}

/// Where a received lot stands. Only USABLE may be picked for production.
enum StockLotStatus {
  QUARANTINE
  USABLE
  REJECTED
  ON_HOLD
  CONSUMED
}

/// Payment progress of a purchase invoice, as US-PUR-05 defines it.
///
/// The status IS the payment progress, maintained by the payment service. An
/// earlier design kept a document status here and derived the payment state
/// separately, which meant two fields answering "has this been paid" and the
/// possibility of them disagreeing.
///
/// Overdue is deliberately absent: it is "unpaid and past the due date", a
/// fact about today rather than about the invoice, so the payables report
/// computes it per request instead of storing a flag that goes stale nightly.
enum PurchaseInvoiceStatus {
  BOOKED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

/// Why a ledger row exists. The ledger is append-only, so a correction is a new
/// row with the opposite sign rather than an edit.
enum StockLedgerEntryType {
  GRN_QUARANTINE
  QC_ACCEPTED
  QC_REJECTED
  QC_HOLD
  QC_RELEASED_FROM_HOLD
  ADJUSTMENT
}

// -----------------------------------------------------------------------------
// Master data
// -----------------------------------------------------------------------------

/// A material or product — the item master.
///
/// THIS MODEL MIRRORS THE SHARED DATABASE EXACTLY and is not this module's to
/// redesign. It arrived from the master-data branch, it is what the Render
/// database holds, and Procure-to-Pay reads it rather than keeping a parallel
/// item table of its own. Three consequences worth naming, because each one
/// shaped code elsewhere:
///
///   * `uom` is free text, not an enum. Looser than this module would have
///     chosen — "kg" and "Kg" can both be stored — but a shared column is not
///     the place to unilaterally tighten a type.
///   * `gstRate` lives here, next to `hsnCode`, rather than in a separate tax
///     master. So the item master IS the tax master, and a purchase invoice
///     reads its GST percentage straight off the item.
///   * There is no `requiresBatchTracking` flag. Whether a receipt must carry a
///     batch number is derived from `type` instead: raw material, packing
///     material and semi-finished goods are all batch tracked.
model Item {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Internal code, e.g. "RM-PARA-001". Unique within the tenant.
  code String   @db.VarChar(64)
  name String   @db.VarChar(255)
  type ItemType

  /// Unit of measure, free text on the shared schema.
  uom String @db.VarChar(16)

  /// Total shelf life of the material, in MONTHS — not the remaining life
  /// demanded on arrival. Goods receipt converts it before comparing.
  shelfLifeMonths Int? @map("shelf_life_months")

  hsnCode String? @map("hsn_code") @db.VarChar(16)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  // ---------------------------------------------------------------------------
  // Pharmaceutical and commercial attributes
  // ---------------------------------------------------------------------------

  brandName   String? @map("brand_name") @db.VarChar(255)
  genericName String? @map("generic_name") @db.VarChar(512)

  /// Drugs and Cosmetics Rules schedule. H1 in particular obliges a separate
  /// register of supply, so it is a property of the item, not of a document.
  scheduleClassification ScheduleClassification @default(NONE) @map("schedule_classification")

  /// GST percentage for this item. The figure a purchase invoice computes tax
  /// from — never typed onto the invoice itself.
  gstRate Decimal? @map("gst_rate") @db.Decimal(5, 2)

  mrp Decimal? @db.Decimal(12, 2)

  /// True when the product sits under a DPCO price ceiling, so its MRP is
  /// capped by order rather than chosen.
  dpcoCeiling Boolean @default(false) @map("dpco_ceiling")

  storageConditions String? @map("storage_conditions") @db.VarChar(255)

  // ---------------------------------------------------------------------------
  // Reorder policy — the Procure-to-Pay trigger
  // ---------------------------------------------------------------------------

  /// When usable stock falls below this, the item is a candidate for
  /// requisition. NULLABLE on the shared schema: null means no reorder policy
  /// is configured, which is different from a level of zero and must not be
  /// silently treated as one.
  reorderLevel Decimal? @map("reorder_level") @db.Decimal(14, 3)

  /// How much to buy when the level is breached — the order quantity, not the
  /// shortfall. Ordering exactly the shortfall puts stock back on the
  /// threshold, so the next issue trips the reorder again.
  reorderQuantity Decimal? @map("reorder_quantity") @db.Decimal(14, 3)

  /// Whether a receipt of this item must carry a batch number and expiry.
  /// A COLUMN, not a derived constant: printed leaflets and cartons are both
  /// packing material, and one may reasonably be lot-tracked while the other
  /// is not — so `type` cannot express the exception. Defaults true and no
  /// form exposes it: turning off lot traceability in a GMP plant needs a
  /// recorded reason, not a tick box.
  requiresBatchTracking Boolean @default(true) @map("requires_batch_tracking")

  notes String? @db.VarChar(1000)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  boms            Bom[]
  bomLines        BomLine[]
  productionPlans ProductionPlan[]

  /// As the finished good being packed, and as a component consumed by a pack.
  /// Two relations to one model, so both need names.
  packagingRequirements     PackagingRequirement[]     @relation("PackagingRequirementProduct")
  packagingRequirementLines PackagingRequirementLine[] @relation("PackagingRequirementComponent")
  packagingConsumptions     BatchPackagingConsumption[] @relation("BatchPackagingComponent")

  requisitions                PurchaseRequisition[] @relation("RequisitionItem")
  requisitionsAsFinishedGood  PurchaseRequisition[] @relation("RequisitionFinishedProduct")
  requisitionsAsPackComponent PurchaseRequisition[] @relation("RequisitionPackagingComponent")

  purchaseOrderLines PurchaseOrderLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  stockLots          StockLot[]
  ledgerEntries      StockLedgerEntry[]
  invoiceLines       PurchaseInvoiceLine[]

  // Production & Quality Gate. Stock is `stockLots` in the block above: one
  // stock table, shared with Procure-to-Pay.
  productionOrders  ProductionOrder[]
  issueLines        MaterialIssueLine[]
  finishedGoodsLots FinishedGoodsLot[]
  salesOrderItems   SalesOrderItem[]
  salesInvoiceItems SalesInvoiceItem[]
  salesReturnItems  SalesReturnItem[]

  @@unique([tenantId, code])
  @@index([tenantId, type, deletedAt])
  @@map("items")
}

// -----------------------------------------------------------------------------
// Bill of material
// -----------------------------------------------------------------------------

/// A versioned formulation: what one production run of a product consumes.
///
/// Also from the master-data branch. Procure-to-Pay uses it rather than keeping
/// its own component list — a manual requisition cites the production plan, and
/// the plan cites the BOM, so "what does this run need" has exactly one answer.
model Bom {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The finished or semi-finished item this formulation makes.
  productId String @map("product_id") @db.Uuid

  /// Versioned rather than edited in place: a batch made last year was made to
  /// a specific formulation, and that has to stay readable.
  version Int

  /// What one run of this BOM yields, in the product's own unit.
  outputQuantity Decimal @map("output_quantity") @db.Decimal(14, 3)

  instructions String?

  /// Only one version should be active at a time; enforced by process rather
  /// than a constraint, since a changeover is momentarily ambiguous.
  isActive      Boolean  @default(false) @map("is_active")
  effectiveFrom DateTime @default(now()) @map("effective_from") @db.Date

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Item   @relation(fields: [productId], references: [id], onDelete: Restrict)

  lines            BomLine[]
  productionPlans  ProductionPlan[]
  productionOrders ProductionOrder[]
  /// The principals whose brands this formulation is made under.
  jobWorkMappings  JobWorkProductMapping[]

  @@unique([tenantId, productId, version])
  @@index([tenantId, deletedAt])
  @@map("boms")
}

/// One component a formulation consumes, per unit of output.
model BomLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  bomId  String @map("bom_id") @db.Uuid
  itemId String @map("item_id") @db.Uuid

  /// Quantity of this component per unit of the BOM's output.
  quantityPer Decimal @map("quantity_per") @db.Decimal(14, 3)

  notes String? @db.VarChar(255)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bom    Bom    @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([bomId, itemId])
  @@map("bom_lines")
}

/// A supplier, customer or job-work principal.
model Party {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  code      String    @db.VarChar(64)
  name      String    @db.VarChar(255)
  partyType PartyType @default(VENDOR) @map("party_type")

  gstin             String? @db.VarChar(15)
  /// Vendors of pharmaceutical raw material hold a drug licence too.
  drugLicenceNumber String? @map("drug_licence_number") @db.VarChar(64)

  email   String? @db.VarChar(320)
  phone   String? @db.VarChar(32)
  address String? @db.VarChar(1000)

  /// Net days agreed with this vendor. Seeds the due date on their invoices.
  paymentTermsDays Int @default(30) @map("payment_terms_days")

  // Added by 20260911150000_party_master_compliance for US-MD-02. A CUSTOMER
  // may only be ACTIVE with a licence number AND validity on file — enforced
  // by the parties_active_customer_is_licensed CHECK constraint.
  status             PartyStatus @default(ACTIVE)
  drugLicenceValidTo DateTime?   @map("drug_licence_valid_to") @db.Date
  creditLimit        Decimal?    @map("credit_limit") @db.Decimal(14, 2)
  creditPeriodDays   Int?        @map("credit_period_days")

  // Added by 20260915000000_order_to_cash_customer_register. Customers are
  // parties, not a second master — see that migration's header. All nullable,
  // so every vendor Procure-to-Pay created stays valid without a backfill.
  customerType  CustomerType? @map("customer_type")
  contactPerson String?       @map("contact_person") @db.VarChar(255)

  /// First two digits set the place of supply, deciding IGST vs CGST+SGST.
  /// Separate from the GSTIN because a customer without one still has a state.
  stateCode String? @map("state_code") @db.VarChar(2)

  billingLine1 String? @map("billing_line1") @db.VarChar(255)
  billingLine2 String? @map("billing_line2") @db.VarChar(255)
  billingCity  String? @map("billing_city") @db.VarChar(120)
  billingState String? @map("billing_state") @db.VarChar(120)
  billingPin   String? @map("billing_pin") @db.VarChar(10)

  /// Held apart from billing because goods and paperwork diverge: a distributor
  /// bills to a head office and receives at a warehouse.
  shippingLine1 String? @map("shipping_line1") @db.VarChar(255)
  shippingLine2 String? @map("shipping_line2") @db.VarChar(255)
  shippingCity  String? @map("shipping_city") @db.VarChar(120)
  shippingState String? @map("shipping_state") @db.VarChar(120)
  shippingPin   String? @map("shipping_pin") @db.VarChar(10)

  notes String? @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  preferredForRequisitions PurchaseRequisition[]
  purchaseOrders           PurchaseOrder[]
  goodsReceipts            GoodsReceipt[]
  purchaseInvoices         PurchaseInvoice[]
  /// Set only on a JOB_WORK_PRINCIPAL; see JobWorkAgreement.principalId.
  jobWorkAgreements        JobWorkAgreement[]
  documents                CustomerDocument[]
  /// Set only on a CUSTOMER; see CustomerLicence.
  customerLicences         CustomerLicence[]
  salesOrders              SalesOrder[]
  dispatches               Dispatch[]
  salesInvoices            SalesInvoice[]
  receipts                 Receipt[]
  salesReturns             SalesReturn[]
  receivableEntries        ReceivableLedgerEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, partyType, deletedAt])
  @@index([tenantId, drugLicenceValidTo])
  @@index([tenantId, customerType])
  @@map("parties")
}

/// A customer's paperwork — drug licence, GST certificate, purchase agreement —
/// held against the party it belongs to.
///
/// THE BYTES ARE IN POSTGRES, not on a disk. The hosted service declares no
/// persistent disk, so a file written to the filesystem is destroyed on the
/// next deploy while the row pointing at it survives — a record of a document
/// that is no longer anywhere. In the database the bytes are in the same
/// backups as everything else and, more importantly, under the same row-level
/// security: one company physically cannot read another's paperwork, which a
/// filesystem path does not give you.
///
/// Capped at 5 MB by the service and by a CHECK constraint. Every read pulls
/// the whole file through the connection, so this is for certificates and
/// scans, not a general file store.
model CustomerDocument {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The party. Only a CUSTOMER may have documents â€” enforced in the service,
  /// because a CHECK constraint cannot read another table.
  partyId String @map("party_id") @db.Uuid

  /// Kept verbatim, so a download arrives with the name it was sent with.
  fileName    String @map("file_name") @db.VarChar(255)
  /// Whitelisted by the service. Stored so a download sets the right
  /// Content-Type rather than guessing from the extension.
  contentType String @map("content_type") @db.VarChar(127)
  sizeBytes   Int    @map("size_bytes")
  content     Bytes

  /// What the document IS, in the uploader's words. Free text rather than an
  /// enum: the set of documents a customer might be asked for is not fixed.
  label String? @db.VarChar(255)

  uploadedById String @map("uploaded_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  party      Party  @relation(fields: [partyId], references: [id], onDelete: Restrict)
  uploadedBy User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([tenantId, partyId, deletedAt])
  @@map("customer_documents")
}

/// The customer's drug licences — distinct from `Licence`, which is the
/// company's OWN register.
///
/// A child table rather than more columns on Party because a distributor holds
/// several at once: a retail 20B, a wholesale 21B, sometimes a Schedule X
/// endorsement, each with its own number, authority and expiry. The existing
/// `Party.drugLicenceNumber` / `drugLicenceValidTo` pair holds one and is what
/// US-MD-02's CHECK constraint reads, so it is left untouched; this register
/// sits alongside it.
model CustomerLicence {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  partyId  String @map("party_id") @db.Uuid

  licenceNumber String                  @map("licence_number") @db.VarChar(64)
  category      CustomerLicenceCategory
  /// "20B", "21B" â€” the form the licence was granted on.
  formNumber    String?                 @map("form_number") @db.VarChar(32)

  issuingAuthority String? @map("issuing_authority") @db.VarChar(255)

  /// Dates, not timestamps: a licence is valid for a day in the issuing
  /// authority's calendar, and an instant would make validity depend on the
  /// reader's timezone.
  issueDate  DateTime @map("issue_date") @db.Date
  expiryDate DateTime @map("expiry_date") @db.Date

  status CustomerLicenceStatus @default(ACTIVE)

  /// Schedule X needs a specific endorsement; a wholesale licence is not
  /// enough. The allocation gate reads this directly.
  coversScheduleX Boolean @default(false) @map("covers_schedule_x")

  /// The one the order gate tests when it needs a single answer. At most one
  /// per customer, enforced by a partial unique index in the migration.
  isPrimary Boolean @default(false) @map("is_primary")

  notes String? @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  party  Party  @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@unique([tenantId, partyId, licenceNumber])
  @@index([tenantId, expiryDate])
  @@map("customer_licences")
}

// -----------------------------------------------------------------------------
// Licence — the company's own statutory permissions (US-MD-04)
// -----------------------------------------------------------------------------

/// One licence held by this company, with the date it lapses.
///
/// Not to be confused with `Party.drugLicenceNumber`, which is somebody else's
/// licence recorded on their party record. This table is the company's own
/// paperwork: the manufacturing licence that makes production lawful at all.
///
/// The expiry date is the entire point. An expired manufacturing licence does
/// not stop the line by itself, so the system has to be the thing that notices,
/// and it can only notice a date it has been told — hence
/// `Tenant.licenceAlertLeadDays` and the dashboard section that reads it.
///
/// VISIBILITY: Admin and Quality Officer only, enforced by `@Roles(...)` on the
/// licences controller rather than by row-level security. RLS here isolates one
/// tenant from another; it knows nothing about application roles, and the two
/// concerns are kept in the layers that can actually express them.
model Licence {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  licenceType LicenceType @map("licence_type")

  /// As printed on the certificate, e.g. "25/MH/2021/000456". Quoted on
  /// invoices and batch records, so it is stored exactly as issued.
  licenceNumber String @map("licence_number") @db.VarChar(64)

  /// Who issued it — "Food and Drug Administration, Maharashtra". Needed
  /// because renewal goes back to the same office.
  issuingAuthority String @map("issuing_authority") @db.VarChar(255)

  /// Dates, not timestamps: a licence is valid for a day in the issuing
  /// authority's calendar, and storing an instant would make validity depend on
  /// the reader's timezone.
  issuedOn   DateTime? @map("issued_on") @db.Date
  expiryDate DateTime  @map("expiry_date") @db.Date

  notes String? @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete. A licence that covered a batch made last year is part of that
  /// batch's compliance record and survives being retired from the register.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// One live record per licence number of a given type. Renewals replace the
  /// expiry date on the existing row rather than accumulating near-duplicates
  /// nobody can tell apart.
  @@unique([tenantId, licenceType, licenceNumber])
  /// Drives the expiry sweep: whose licence lapses next.
  @@index([tenantId, expiryDate, deletedAt])
  @@map("licences")
}

// -----------------------------------------------------------------------------
// Job-work — manufacturing under somebody else's brand (US-MD-05)
// -----------------------------------------------------------------------------

/// The commercial terms under which this company manufactures for a principal.
///
/// A principal is a brand owner you manufacture for: the same physical product
/// leaves the line carrying THEIR brand name and THEIR pack design, not yours.
/// The mappings below are what keep those two identities attached to one
/// formulation without duplicating it.
model JobWorkAgreement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The brand owner, from the Party register. Constrained to a party of type
  /// JOB_WORK_PRINCIPAL by the service rather than by SQL: a CHECK cannot read
  /// another table, and a trigger that did would fire on every write to
  /// `parties` as well.
  principalId String @map("principal_id") @db.Uuid

  /// The parties' own reference for the contract, e.g. "JW-2026-018". Optional
  /// because a verbal arrangement still has to be recordable, but unique per
  /// company when given — two agreements under one reference is how the wrong
  /// terms get quoted.
  agreementReference String? @map("agreement_reference") @db.VarChar(64)

  /// US-MD-05: "The billing model is a mandatory field on the agreement."
  /// NOT NULL is that criterion, in the only place that can guarantee it.
  ///
  /// The criterion's second half — "cannot be changed on an order that is
  /// already in production" — is NOT enforced yet, because production orders
  /// do not carry an agreement. When the Production module is built, a work
  /// order raised under an agreement must COPY this value at creation (the way
  /// ProductionOrder.bomId is already pinned) and refuse to change it once the
  /// order leaves PLANNED. Renegotiating terms next month must not silently
  /// rewrite what last month's batch was billed on.
  billingModel BillingModel @map("billing_model")

  /// Charged on conversion and packing, not on the value of the goods. Held
  /// with its basis; see the CHECK that keeps the two together.
  conversionChargeRate Decimal?             @map("conversion_charge_rate") @db.Decimal(12, 2)
  conversionRateBasis  ConversionRateBasis? @map("conversion_rate_basis")

  /// Dates, not timestamps: a contract runs for calendar days, and storing an
  /// instant would make "in force today" depend on the reader's timezone.
  validFrom DateTime? @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date

  notes String? @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete. An agreement that governed a batch made last year is part of
  /// that batch's commercial record.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  principal Party  @relation(fields: [principalId], references: [id], onDelete: Restrict)

  mappings JobWorkProductMapping[]

  @@index([tenantId, principalId, deletedAt])
  @@index([tenantId, validTo])
  @@map("job_work_agreements")
}

/// One of our formulations, as the principal knows it (US-MD-05).
///
/// The criterion: "The product-brand mapping must link one or more of the
/// company's BOMs to the principal's specific brand name and pack design."
///
/// The link is to a BOM rather than to an Item on purpose. A BOM is a specific
/// version of a specific formulation, and what the principal is buying is that
/// recipe — not merely the product code, which survives a reformulation.
///
/// "One or more" is enforced by the service inside the creating transaction,
/// not in SQL: a CHECK constraint cannot count rows in another table, and the
/// same rule already lives in the service for BOM lines.
model JobWorkProductMapping {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  agreementId String @map("agreement_id") @db.Uuid
  bomId       String @map("bom_id") @db.Uuid

  /// What the carton says. This is the name the product is sold under, and it
  /// is the principal's property, not ours.
  principalBrandName String @map("principal_brand_name") @db.VarChar(255)

  /// The artwork reference the pack is printed to, e.g. "ART-DOLO-500-10x10".
  /// Optional: the mapping is still useful before artwork is finalised.
  packDesignRef String? @map("pack_design_ref") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agreement JobWorkAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  bom       Bom              @relation(fields: [bomId], references: [id], onDelete: Restrict)

  /// One line per formulation per agreement. The same recipe billed two ways
  /// in one contract is a contradiction, not a case to support.
  @@unique([agreementId, bomId])
  @@index([tenantId, bomId])
  @@map("job_work_product_mappings")
}

// -----------------------------------------------------------------------------
// Packaging requirements — what a pack consumes (US-MD-06)
// -----------------------------------------------------------------------------

/// The component list for one product in one pack presentation.
///
/// Held per PACK VARIANT, not per product: the same tablet in a 10x10 blister
/// carton and in a 500-count jar needs a completely different component list,
/// and folding them into one record makes every shortage check ambiguous.
///
/// This is the packaging counterpart of Bom — Bom says what the product is made
/// OF, this says what it is packed IN. The two are deliberately separate
/// records: a formulation change is a regulatory event, a carton artwork change
/// usually is not, and versioning them together would drag one through the
/// other's approval.
///
/// US-MD-06's first criterion — "a finished product cannot go into a Work Order
/// until it has at least one active Packaging Requirement Master entry" — reads
/// `isActive` here, and is enforced in ProductionService.createProductionOrder
/// beside the identical active-BOM check that US-MD-03 put there.
model PackagingRequirement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The finished good being packed. An Item of type FINISHED_GOOD, checked by
  /// the service — a CHECK constraint cannot read another table.
  productId String @map("product_id") @db.Uuid

  /// The presentation, e.g. "10 x 10 blister carton". Matched against
  /// ProductionPlan.packVariant when the shortage sweep runs.
  packVariant String @map("pack_variant") @db.VarChar(128)

  /// How many units of the product one pack holds — 100 for a 10x10 carton.
  ///
  /// Not in the original field list, and required: without it a PER_PACK
  /// quantity cannot be scaled to a batch at all. A batch of 100,000 tablets
  /// needs 1,000 cartons only if something records that a carton holds 100.
  unitsPerPack Decimal @map("units_per_pack") @db.Decimal(14, 3)

  /// US-MD-06's gate. Deactivating is how a superseded pack stops blocking
  /// work orders without destroying the record of how it used to be packed.
  isActive Boolean @default(true) @map("is_active")

  notes String? @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete. The specification a batch was packed to is part of that
  /// batch's record.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product Item   @relation("PackagingRequirementProduct", fields: [productId], references: [id], onDelete: Restrict)

  lines PackagingRequirementLine[]

  /// Drives the AC1 gate and the shortage sweep: has this product an active
  /// pack spec, and which one matches the plan's variant.
  ///
  /// Named explicitly because Prisma's generated name for four columns is
  /// truncated to something different from what the migration created, and the
  /// migration is already applied on the hosted database with its checksum
  /// recorded — editing it there would fail the next deploy. The schema states
  /// the name that exists.
  @@index([tenantId, productId, isActive, deletedAt], map: "packaging_requirements_tenant_id_product_id_is_active_idx")
  @@map("packaging_requirements")
}

/// One component a pack consumes.
///
/// No `deletedAt` and no no-hard-delete trigger: a line belongs to its pack
/// specification and cascades from it, exactly as BomLine does. Blocking DELETE
/// here would block editing the specification.
model PackagingRequirementLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  requirementId String @map("requirement_id") @db.Uuid

  /// The packing material. An Item of type PACKING_MATERIAL — checked by the
  /// service, so a raw material cannot be listed as a carton.
  itemId String @map("item_id") @db.Uuid

  level PackagingLevel

  /// Counted against `quantityBasis`. Decimal(14,3) to match BomLine, because
  /// these quantities are scaled by the same arithmetic and a narrower type
  /// here would round differently from the formulation beside it.
  quantityPer   Decimal                @map("quantity_per") @db.Decimal(14, 3)
  quantityBasis PackagingQuantityBasis @map("quantity_basis")

  /// Whether a shortage blocks packing or merely warns.
  requirement PackagingComponentRequirement @default(MANDATORY)

  notes String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  packaging PackagingRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  item      Item                 @relation("PackagingRequirementComponent", fields: [itemId], references: [id], onDelete: Restrict)

  /// One line per component per specification. The same carton listed twice
  /// with different quantities is a contradiction, not a case to support.
  @@unique([requirementId, itemId])
  /// Answers the reverse question the shortage sweep asks: which pack specs
  /// consume this component?
  @@index([tenantId, itemId])
  @@map("packaging_requirement_lines")
}

/// Per-tenant document numbering (PR-2026-0001, PO-2026-0001, ...).
///
/// A table rather than counting existing rows: two requisitions raised in the
/// same second would otherwise compute the same number, and the unique index
/// would turn that into a failed save for whoever lost the race. An atomic
/// increment inside the creating transaction has no such window.
model DocumentSequence {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// "PR", "PO", "GRN", "PINV", "PAY", "LOT".
  docType String @map("doc_type") @db.VarChar(16)
  year    Int

  nextValue Int @default(1) @map("next_value")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, docType, year])
  @@map("document_sequences")
}

// -----------------------------------------------------------------------------
// 1. Purchase requisition
// -----------------------------------------------------------------------------

/// A request to buy one raw material, raised because stock fell below its
/// reorder level.
model PurchaseRequisition {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  number String @db.VarChar(32)

  itemId String @map("item_id") @db.Uuid

  /// Stock and reorder level AS THEY WERE when the requisition was raised.
  ///
  /// Snapshots, not live reads, because the requisition has to justify itself
  /// later: "raised when stock was 20 against a reorder level of 50" is the
  /// record. Live values move, and a document that silently rewrites its own
  /// reason is not a document.
  stockAtRequest        Decimal @map("stock_at_request") @db.Decimal(18, 4)
  reorderLevelAtRequest Decimal @map("reorder_level_at_request") @db.Decimal(18, 4)

  requiredQuantity Decimal @map("required_quantity") @db.Decimal(18, 4)

  preferredVendorId String? @map("preferred_vendor_id") @db.Uuid

  /// What the material is ultimately for, and where it sits in the pack.
  ///
  /// All of it optional, and all of it POINTING AT master data rather than
  /// repeating it: a requisition for a raw material that serves no single
  /// product answers none of these, and a requisition for a carton answers all
  /// of them. Forcing a value would mean inventing one.
  finishedProductId String? @map("finished_product_id") @db.Uuid

  /// Pack presentation, e.g. "10x10 blister". Free text because there is no
  /// pack-variant master to reference — the same as `ProductionPlan`.
  packVariant String? @map("pack_variant") @db.VarChar(128)

  /// Distinct from `itemId`: `itemId` is what is being bought, this is the
  /// component of the finished pack it plays a part in.
  packagingComponentId String?         @map("packaging_component_id") @db.Uuid
  packagingLevel       PackagingLevel? @map("packaging_level")

  /// The rate the buy quantity was derived from — per unit or per batch of the
  /// finished product. Keeping it makes `requiredQuantity` auditable later.
  quantityPerUnit Decimal? @map("quantity_per_unit") @db.Decimal(18, 4)

  /// Mandatory by default: treating an unspecified component as optional
  /// invites it to be dropped from an order.
  isMandatory Boolean @default(true) @map("is_mandatory")

  /// Why this requisition exists. Decides what else is required: a MANUAL one
  /// must name a production plan, an AUTO_REORDER one must not.
  triggerType RequisitionTriggerType @default(MANUAL) @map("trigger_type")

  /// The production run this material is for. Required for MANUAL, enforced
  /// in the service because the rule is conditional on `triggerType`.
  productionPlanId String? @map("production_plan_id") @db.Uuid

  /// Acting user ids. See the note at the top of this section on why these
  /// carry no relation.
  ///
  /// NULLABLE because an auto-reorder requisition has no author. Attributing
  /// one to whichever user's request happened to trip the reorder check would
  /// be a lie in the audit trail — the system raised it, and the trail should
  /// say so.
  requestedById String?   @map("requested_by_id") @db.Uuid
  approvedById  String?   @map("approved_by_id") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz(6)

  requestDate    DateTime  @default(now()) @map("request_date") @db.Timestamptz(6)
  requiredByDate DateTime? @map("required_by_date") @db.Timestamptz(6)

  status RequisitionStatus @default(OPEN)
  notes  String?           @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item            Item            @relation("RequisitionItem", fields: [itemId], references: [id], onDelete: Restrict)
  preferredVendor Party?          @relation(fields: [preferredVendorId], references: [id], onDelete: Restrict)
  productionPlan  ProductionPlan? @relation(fields: [productionPlanId], references: [id], onDelete: Restrict)

  /// Three separate references into the item master, so each is named. Prisma
  /// cannot infer which is which once a model points at another more than once.
  finishedProduct    Item? @relation("RequisitionFinishedProduct", fields: [finishedProductId], references: [id], onDelete: Restrict)
  packagingComponent Item? @relation("RequisitionPackagingComponent", fields: [packagingComponentId], references: [id], onDelete: Restrict)

  purchaseOrderLines PurchaseOrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, itemId])
  @@index([tenantId, triggerType, status])
  @@index([tenantId, finishedProductId])
  @@index([tenantId, packagingComponentId])
  @@map("purchase_requisitions")
}

// -----------------------------------------------------------------------------
// 2. Purchase order
// -----------------------------------------------------------------------------

model PurchaseOrder {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  number   String @db.VarChar(32)
  vendorId String @map("vendor_id") @db.Uuid

  poDate               DateTime  @default(now()) @map("po_date") @db.Timestamptz(6)
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Timestamptz(6)

  paymentTermsDays Int @default(30) @map("payment_terms_days")

  status PurchaseOrderStatus @default(OPEN)
  notes  String?             @db.VarChar(1000)

  /// Stored totals, computed from the lines at write time.
  ///
  /// Not recomputed on read: an issued purchase order is a commitment at the
  /// figures it was issued with. If a tax rate or a rounding rule changes next
  /// year, the document must still say what both parties agreed to.
  taxableAmount Decimal @default(0) @map("taxable_amount") @db.Decimal(18, 2)
  taxAmount     Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount   Decimal @default(0) @map("total_amount") @db.Decimal(18, 2)

  createdById String    @map("created_by_id") @db.Uuid
  issuedAt    DateTime? @map("issued_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vendor Party  @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  lines            PurchaseOrderLine[]
  goodsReceipts    GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([tenantId, number])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, vendorId])
  @@map("purchase_orders")
}

/// One item on a purchase order.
///
/// Lines rather than one item per order: a GRN receives against specific lines,
/// and an invoice matches against them. A single-item order would have made
/// every one of those a special case the day a vendor ships two materials on
/// one delivery note.
model PurchaseOrderLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  itemId          String @map("item_id") @db.Uuid

  /// The requisition this line satisfies, when it came from one. Nullable
  /// because a buyer may add a line directly; business rule 2 is served by
  /// keeping the link wherever it exists.
  requisitionId String? @map("requisition_id") @db.Uuid

  quantity       Decimal @db.Decimal(18, 4)
  rate           Decimal @db.Decimal(18, 4)
  /// GST percentage applied to this line, e.g. 12.00.
  taxRatePercent Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)

  taxableAmount Decimal @map("taxable_amount") @db.Decimal(18, 2)
  taxAmount     Decimal @map("tax_amount") @db.Decimal(18, 2)
  totalAmount   Decimal @map("total_amount") @db.Decimal(18, 2)

  /// Running total of what has been received against this line, maintained by
  /// the GRN service. Unlike item stock this IS stored: it is the line's own
  /// fulfilment state, written in the same transaction as the receipt that
  /// changes it, and it decides the order's status.
  quantityReceived Decimal @default(0) @map("quantity_received") @db.Decimal(18, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item                 @relation(fields: [itemId], references: [id], onDelete: Restrict)
  requisition   PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: Restrict)

  goodsReceiptLines GoodsReceiptLine[]

  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, itemId])
  @@map("purchase_order_lines")
}

// -----------------------------------------------------------------------------
// 3. Goods receipt note
// -----------------------------------------------------------------------------

model GoodsReceipt {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  number          String @db.VarChar(32)
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  /// Denormalised from the order so a GRN list can filter and display by vendor
  /// without joining two levels up. Written once, from the order, never from a
  /// request body.
  vendorId        String @map("vendor_id") @db.Uuid

  receiptDate DateTime @default(now()) @map("receipt_date") @db.Timestamptz(6)

  /// Vendor's own delivery-note / invoice reference, for reconciliation.
  vendorDocumentNumber String? @map("vendor_document_number") @db.VarChar(64)

  receivedById String  @map("received_by_id") @db.Uuid
  remarks      String? @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  vendor        Party         @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  lines            GoodsReceiptLine[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([tenantId, number])
  @@index([tenantId, purchaseOrderId])
  @@index([tenantId, receiptDate])
  @@map("goods_receipts")
}

/// One received material on a GRN. Each line produces exactly one StockLot.
model GoodsReceiptLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  goodsReceiptId      String @map("goods_receipt_id") @db.Uuid
  purchaseOrderLineId String @map("purchase_order_line_id") @db.Uuid
  itemId              String @map("item_id") @db.Uuid

  /// The vendor's batch identity, kept verbatim. Mandatory for batch-tracked
  /// materials -- enforced in the service, because whether it is required
  /// depends on the item.
  vendorBatchNumber String?   @map("vendor_batch_number") @db.VarChar(64)
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date

  quantityReceived Decimal @map("quantity_received") @db.Decimal(18, 4)
  /// Visibly damaged or short-shipped at the gate, refused before QC ever sees
  /// it. QC's own accept/reject decision happens later, on the lot.
  quantityRejected Decimal @default(0) @map("quantity_rejected") @db.Decimal(18, 4)

  storageLocation String? @map("storage_location") @db.VarChar(128)
  remarks         String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  goodsReceipt      GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id], onDelete: Restrict)
  item              Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)

  stockLot StockLot?

  @@index([tenantId, goodsReceiptId])
  @@map("goods_receipt_lines")
}

// -----------------------------------------------------------------------------
// 4. Stock lot (the batch) and incoming QC
// -----------------------------------------------------------------------------

/// A physical batch of raw material, as received.
///
/// This is the unit inventory is tracked in -- never an anonymous quantity
/// against an item. Batch number, manufacturing date and expiry travel with it
/// for its whole life, which is what makes recall and FEFO possible at all.
model StockLot {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Our internal lot identity, e.g. "LOT-2026-0007". Distinct from the
  /// vendor's batch number, which is theirs and may collide across vendors.
  lotNumber String @map("lot_number") @db.VarChar(32)

  itemId             String @map("item_id") @db.Uuid
  goodsReceiptLineId String @unique @map("goods_receipt_line_id") @db.Uuid

  vendorBatchNumber String?   @map("vendor_batch_number") @db.VarChar(64)
  manufacturingDate DateTime? @map("manufacturing_date") @db.Date
  expiryDate        DateTime? @map("expiry_date") @db.Date

  /// What arrived, and what is left. `quantityAvailable` is decremented by
  /// production issues later; it is only ever meaningful while status is USABLE.
  quantityReceived  Decimal @map("quantity_received") @db.Decimal(18, 4)
  quantityAvailable Decimal @map("quantity_available") @db.Decimal(18, 4)

  /// QUARANTINE on creation, always. Business rule 6: a GRN does not make
  /// material usable, incoming QC does.
  status StockLotStatus @default(QUARANTINE)

  storageLocation String? @map("storage_location") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item             Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  goodsReceiptLine GoodsReceiptLine @relation(fields: [goodsReceiptLineId], references: [id], onDelete: Restrict)

  qcResults     QcResult[]
  ledgerEntries StockLedgerEntry[]
  /// Production consumes the same stock Procure-to-Pay received; see the note
  /// on MaterialIssueLine.lot.
  issueLines    MaterialIssueLine[]
  packagingConsumptions BatchPackagingConsumption[]

  @@unique([tenantId, lotNumber])
  /// The FEFO index: usable lots of an item, earliest expiry first.
  @@index([tenantId, itemId, status, expiryDate])
  @@map("stock_lots")
}

/// One incoming-QC decision on one lot.
///
/// Rows accumulate rather than being overwritten: a lot put on hold and later
/// released has two decisions, and both are part of the record. The lot's
/// current `status` reflects the latest, maintained by the QC service in the
/// same transaction.
model QcResult {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  stockLotId String @map("stock_lot_id") @db.Uuid

  decision QcDecision

  /// Analytical report reference, e.g. a COA number.
  testReference String? @map("test_reference") @db.VarChar(64)
  remarks       String? @db.VarChar(1000)

  inspectedById String   @map("inspected_by_id") @db.Uuid
  inspectedAt   DateTime @default(now()) @map("inspected_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  stockLot StockLot @relation(fields: [stockLotId], references: [id], onDelete: Restrict)

  @@index([tenantId, stockLotId, createdAt])
  @@map("qc_results")
}

/// The raw-material stock ledger: every movement, append-only.
///
/// Append-only for the same reason AuditLog is -- a ledger whose rows can be
/// edited is not evidence of anything. A mistake is corrected by posting the
/// opposite entry, which is also how the correction becomes visible.
model StockLedgerEntry {
  id       BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid

  itemId     String  @map("item_id") @db.Uuid
  stockLotId String? @map("stock_lot_id") @db.Uuid

  entryType StockLedgerEntryType @map("entry_type")

  /// Signed. Positive adds to the balance this entry describes, negative
  /// removes. A QC rejection posts a negative quarantine movement and no
  /// usable movement at all.
  quantityDelta Decimal @map("quantity_delta") @db.Decimal(18, 4)

  /// Whether this movement affected usable stock or quarantined stock. Keeping
  /// both in one ledger with a flag, rather than two tables, means the full
  /// history of a lot reads in one query and in one order.
  affectsUsableStock Boolean @default(false) @map("affects_usable_stock")

  /// Document that caused it, e.g. "GRN-2026-0003".
  reference String? @db.VarChar(64)
  notes     String? @db.VarChar(500)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item     Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  stockLot StockLot? @relation(fields: [stockLotId], references: [id], onDelete: Restrict)

  @@index([tenantId, itemId, createdAt])
  @@index([tenantId, stockLotId, createdAt])
  @@map("stock_ledger_entries")
}

// -----------------------------------------------------------------------------
// 5. Purchase invoice
// -----------------------------------------------------------------------------

model PurchaseInvoice {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Our internal reference. The vendor's own number is `vendorInvoiceNumber`;
  /// both are kept because reconciliation needs theirs and audit needs ours.
  number              String @db.VarChar(32)
  vendorInvoiceNumber String @map("vendor_invoice_number") @db.VarChar(64)

  vendorId        String @map("vendor_id") @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid
  /// The receipt this invoice bills for. MANDATORY: an invoice with no
  /// receipt behind it is a request to pay for goods nobody confirmed
  /// arriving, which is precisely what three-way matching exists to prevent.
  goodsReceiptId  String @map("goods_receipt_id") @db.Uuid

  /// Set when quantity or rate departs from the GRN/PO by more than the
  /// tenant's configured tolerance.
  ///
  /// Recorded rather than merely refused: a genuine price revision has to be
  /// bookable, but it must be visible as an exception afterwards rather than
  /// disappearing into a total. `matchNotes` says which lines differed and by
  /// how much.
  toleranceExceeded Boolean @default(false) @map("tolerance_exceeded")
  matchNotes        String? @map("match_notes") @db.VarChar(2000)

  invoiceDate DateTime @map("invoice_date") @db.Timestamptz(6)
  dueDate     DateTime @map("due_date") @db.Timestamptz(6)

  paymentTermsDays Int @default(30) @map("payment_terms_days")

  taxableAmount Decimal @default(0) @map("taxable_amount") @db.Decimal(18, 2)
  /// GST input tax. Captured separately because it is reclaimable and has to be
  /// reportable on its own, not buried inside a gross total.
  taxAmount     Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)
  totalAmount   Decimal @default(0) @map("total_amount") @db.Decimal(18, 2)

  status PurchaseInvoiceStatus @default(BOOKED)
  notes  String?               @db.VarChar(1000)

  recordedById String @map("recorded_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vendor        Party         @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  goodsReceipt  GoodsReceipt  @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)

  lines    PurchaseInvoiceLine[]
  payments VendorPayment[]

  @@unique([tenantId, number])
  /// One vendor cannot bill the same invoice number twice.
  @@unique([tenantId, vendorId, vendorInvoiceNumber])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, dueDate])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  purchaseInvoiceId String @map("purchase_invoice_id") @db.Uuid
  itemId            String @map("item_id") @db.Uuid

  quantity       Decimal @db.Decimal(18, 4)
  rate           Decimal @db.Decimal(18, 4)
  taxRatePercent Decimal @default(0) @map("tax_rate_percent") @db.Decimal(5, 2)

  taxableAmount Decimal @map("taxable_amount") @db.Decimal(18, 2)
  taxAmount     Decimal @map("tax_amount") @db.Decimal(18, 2)
  totalAmount   Decimal @map("total_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  item            Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([tenantId, purchaseInvoiceId])
  @@map("purchase_invoice_lines")
}

// -----------------------------------------------------------------------------
// 6. Vendor payment
// -----------------------------------------------------------------------------

/// A payment against one purchase invoice.
///
/// There is no `outstandingAmount` column anywhere. The payable is the
/// invoice's total minus the sum of its payments, computed on read -- a stored
/// balance is one failed update away from a vendor being chased for money
/// already paid.
model VendorPayment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  number            String @db.VarChar(32)
  purchaseInvoiceId String @map("purchase_invoice_id") @db.Uuid

  paymentDate DateTime @default(now()) @map("payment_date") @db.Timestamptz(6)
  amount      Decimal  @db.Decimal(18, 2)

  /// UTR / cheque number / transaction reference.
  reference String? @db.VarChar(64)
  method    String? @db.VarChar(32)
  notes     String? @db.VarChar(500)

  recordedById String @map("recorded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@index([tenantId, purchaseInvoiceId])
  @@map("vendor_payments")
}

// -----------------------------------------------------------------------------
// Production plan
// -----------------------------------------------------------------------------

/// A planned manufacturing run, and the reason a manual requisition exists.
///
/// Deliberately minimal: this is not the Production module. It carries only
/// what Procure-to-Pay needs in order to answer "what is this material being
/// bought for" — the finished product, the pack variant, the planned quantity,
/// and the components that run consumes. Production & Quality Gate will extend
/// it rather than replace it.
model ProductionPlan {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  number String @db.VarChar(32)

  /// The finished product this run makes. An Item of type FINISHED_GOOD —
  /// pointing at the item master rather than repeating a product name, so the
  /// two cannot disagree.
  finishedProductId String @map("finished_product_id") @db.Uuid

  /// Pack presentation, e.g. "10x10 blister" or "60 mL bottle".
  packVariant String? @map("pack_variant") @db.VarChar(128)

  /// The formulation this run follows. Its lines ARE the component list, so
  /// the plan keeps none of its own — a recipe revised in one place cannot
  /// leave stale copies on plans already raised.
  bomId String? @map("bom_id") @db.Uuid

  plannedQuantity Decimal   @map("planned_quantity") @db.Decimal(18, 4)
  plannedDate     DateTime? @map("planned_date") @db.Date

  status ProductionPlanStatus @default(PLANNED)
  notes  String?              @db.VarChar(1000)

  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  finishedProduct Item   @relation(fields: [finishedProductId], references: [id], onDelete: Restrict)
  bom             Bom?   @relation(fields: [bomId], references: [id], onDelete: Restrict)

  requisitions PurchaseRequisition[]

  @@unique([tenantId, number])
  @@index([tenantId, status, deletedAt])
  @@map("production_plans")
}

enum SalesOrderStatus {
  DRAFT
  PENDING_CHECK
  APPROVED
  BLOCKED
  PARTIALLY_ALLOCATED
  ALLOCATED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum SalesOrderItemStatus {
  PENDING
  PARTIALLY_ALLOCATED
  ALLOCATED
  DISPATCHED
  CANCELLED
}

/// NOT_RUN is distinct from FAIL on purpose: an unchecked order is not a
/// refused one, and showing "Fail" for "nobody has asked yet" would stop work
/// that was never blocked.
enum CheckResult {
  NOT_RUN
  PASS
  FAIL
}

/// A distributor's order, priced and gated.
///
/// The gate's verdict is STORED, not recomputed on read. An order approved last
/// Tuesday must not silently re-decide itself today because the customer's
/// balance moved — the person who approved it has to be able to see what they
/// approved. Re-running the check overwrites the snapshot deliberately.
model SalesOrder {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Allocated from DocumentSequence ("SO"), not derived from the id, because
  /// it is quoted on every downstream document.
  orderNumber String @map("order_number") @db.VarChar(32)

  customerId String @map("customer_id") @db.Uuid

  orderDate             DateTime  @map("order_date") @db.Date
  requestedDeliveryDate DateTime? @map("requested_delivery_date") @db.Date

  status SalesOrderStatus @default(DRAFT)

  /// Denormalised from the lines: the list screen sorts by them, and summing
  /// lines per row would turn one query into N.
  totalQuantity Decimal @default(0) @map("total_quantity") @db.Decimal(14, 3)
  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  taxAmount     Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  grandTotal    Decimal @default(0) @map("grand_total") @db.Decimal(14, 2)

  licenceCheck       CheckResult @default(NOT_RUN) @map("licence_check")
  creditCheck        CheckResult @default(NOT_RUN) @map("credit_check")
  checkFailureReason String?     @map("check_failure_reason") @db.VarChar(500)
  checkedAt          DateTime?   @map("checked_at") @db.Timestamptz(6)

  /// The credit position as at checkedAt, kept so the refusal stays explicable.
  outstandingAmount Decimal? @map("outstanding_amount") @db.Decimal(14, 2)
  creditLimit       Decimal? @map("credit_limit") @db.Decimal(14, 2)
  availableCredit   Decimal? @map("available_credit") @db.Decimal(14, 2)
  orderAmount       Decimal? @map("order_amount") @db.Decimal(14, 2)
  creditShortfall   Decimal? @map("credit_shortfall") @db.Decimal(14, 2)

  licenceNumber     String?   @map("licence_number") @db.VarChar(64)
  licenceExpiryDate DateTime? @map("licence_expiry_date") @db.Date

  notes String? @db.VarChar(1000)

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer  Party  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  items         SalesOrderItem[]
  allocations   BatchAllocation[]
  dispatches    Dispatch[]
  salesInvoices SalesInvoice[]
  salesReturns  SalesReturn[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, customerId])
  @@index([tenantId, orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String @id @default(uuid()) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  salesOrderId String @map("sales_order_id") @db.Uuid

  /// Printed on the invoice, so stored rather than inferred from row order.
  lineNumber Int @map("line_number")

  itemId String @map("item_id") @db.Uuid

  quantityOrdered    Decimal @map("quantity_ordered") @db.Decimal(14, 3)
  quantityAllocated  Decimal @default(0) @map("quantity_allocated") @db.Decimal(14, 3)
  quantityDispatched Decimal @default(0) @map("quantity_dispatched") @db.Decimal(14, 3)

  /// Copied from the item at order time, never read through: a price list
  /// changes, but an order placed at last month's price stays placed at it.
  unitPrice       Decimal @map("unit_price") @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  gstRatePercent  Decimal @default(0) @map("gst_rate_percent") @db.Decimal(5, 2)
  taxableAmount   Decimal @default(0) @map("taxable_amount") @db.Decimal(14, 2)
  taxAmount       Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineTotal       Decimal @default(0) @map("line_total") @db.Decimal(14, 2)

  status SalesOrderItemStatus @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)

  allocations BatchAllocation[]

  @@unique([salesOrderId, lineNumber])
  @@index([tenantId, itemId])
  @@index([salesOrderId])
  @@map("sales_order_items")
}

enum AllocationStatus {
  ALLOCATED
  PARTIALLY_DISPATCHED
  DISPATCHED
  RELEASED_BACK
  CANCELLED
}

enum DispatchStatus {
  DRAFT
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
  OTHER
}

/// BOUNCED is not CANCELLED: a bounced cheque was received and recorded, then
/// failed. The ledger shows both the credit and its reversal.
enum ReceiptStatus {
  RECORDED
  CLEARED
  BOUNCED
  CANCELLED
}

enum SalesReturnStatus {
  DRAFT
  RECEIVED
  QUARANTINED
  CREDITED
  CANCELLED
}

enum ReturnReason {
  EXPIRED
  NEAR_EXPIRY
  DAMAGED
  BREAKAGE
  WRONG_ITEM
  QUALITY_COMPLAINT
  RECALL
  ORDER_ERROR
  OTHER
}

/// Returned medicine has an unknown storage history, so QUARANTINE is the
/// default and putting it back on the shelf is a decision somebody makes.
enum ReturnedStockDisposition {
  QUARANTINE
  DESTROY
  RESTOCK
}

enum ReceivableEntryType {
  INVOICE
  RECEIPT
  CREDIT_NOTE
  ADJUSTMENT
}

enum ReceivableDirection {
  DEBIT
  CREDIT
}

/// Stock reserved against an order line, picked first-expiry-first-out.
model BatchAllocation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  salesOrderId     String @map("sales_order_id") @db.Uuid
  salesOrderItemId String @map("sales_order_item_id") @db.Uuid
  batchId          String @map("batch_id") @db.Uuid

  quantityAllocated  Decimal @map("quantity_allocated") @db.Decimal(14, 3)
  quantityDispatched Decimal @default(0) @map("quantity_dispatched") @db.Decimal(14, 3)

  /// The expiry as at allocation, so a FEFO decision can be explained later
  /// with the figure it was actually made on.
  expiryDateAtAllocation DateTime @map("expiry_date_at_allocation") @db.Date

  status AllocationStatus @default(ALLOCATED)

  /// Schedule H1 / H1X / X need a second look before stock physically moves.
  complianceRecheckRequired Boolean   @default(false) @map("compliance_recheck_required")
  complianceCheckedAt       DateTime? @map("compliance_checked_at") @db.Timestamptz(6)
  complianceCheckedById     String?   @map("compliance_checked_by_id") @db.Uuid
  complianceNotes           String?   @map("compliance_notes") @db.VarChar(1000)

  allocatedById String? @map("allocated_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  salesOrder          SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  salesOrderItem      SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  batch               Batch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  complianceCheckedBy User?          @relation("AllocationComplianceCheckedBy", fields: [complianceCheckedById], references: [id], onDelete: Restrict)
  allocatedBy         User?          @relation("AllocationAllocatedBy", fields: [allocatedById], references: [id], onDelete: Restrict)

  dispatchItems DispatchItem[]

  @@index([tenantId, salesOrderId])
  @@index([tenantId, batchId])
  @@index([tenantId, status])
  @@index([salesOrderItemId])
  @@map("batch_allocations")
}

model Dispatch {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  dispatchNumber String @map("dispatch_number") @db.VarChar(32)

  salesOrderId   String  @map("sales_order_id") @db.Uuid
  customerId     String  @map("customer_id") @db.Uuid
  /// Nullable: goods may leave before the paperwork is finished.
  salesInvoiceId String? @map("sales_invoice_id") @db.Uuid

  dispatchDate DateTime       @map("dispatch_date") @db.Date
  status       DispatchStatus @default(DRAFT)

  transporterName String? @map("transporter_name") @db.VarChar(255)
  vehicleNumber   String? @map("vehicle_number") @db.VarChar(32)
  /// Lorry receipt number from the transporter.
  lrNumber        String? @map("lr_number") @db.VarChar(64)
  ewayBillNumber  String? @map("eway_bill_number") @db.VarChar(32)

  totalQuantity Decimal @default(0) @map("total_quantity") @db.Decimal(14, 3)

  notes String? @db.VarChar(1000)

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  salesOrder   SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  customer     Party         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice? @relation("DispatchInvoice", fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("DispatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items          DispatchItem[]
  invoicesRaised SalesInvoice[] @relation("InvoiceDispatch")

  @@unique([tenantId, dispatchNumber])
  @@index([tenantId, salesOrderId])
  @@index([tenantId, customerId])
  @@index([tenantId, status, deletedAt])
  @@map("dispatches")
}

model DispatchItem {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  dispatchId String @map("dispatch_id") @db.Uuid

  batchAllocationId String @map("batch_allocation_id") @db.Uuid

  quantityDispatched Decimal @map("quantity_dispatched") @db.Decimal(14, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  dispatch        Dispatch        @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  batchAllocation BatchAllocation @relation(fields: [batchAllocationId], references: [id], onDelete: Restrict)

  @@index([dispatchId])
  @@index([batchAllocationId])
  @@index([tenantId])
  @@map("dispatch_items")
}

/// A tax invoice. Everything printed on it is COPIED at issue, because it is a
/// statutory document and has to keep saying what it said.
model SalesInvoice {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  invoiceNumber String @map("invoice_number") @db.VarChar(32)

  customerId   String  @map("customer_id") @db.Uuid
  salesOrderId String? @map("sales_order_id") @db.Uuid
  dispatchId   String? @map("dispatch_id") @db.Uuid

  invoiceDate DateTime  @map("invoice_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date

  status        InvoiceStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")

  billingName     String  @map("billing_name") @db.VarChar(255)
  billingAddress  String? @map("billing_address") @db.VarChar(1000)
  shippingName    String? @map("shipping_name") @db.VarChar(255)
  shippingAddress String? @map("shipping_address") @db.VarChar(1000)
  customerGstin   String? @map("customer_gstin") @db.VarChar(15)
  sellerGstin     String? @map("seller_gstin") @db.VarChar(15)

  placeOfSupplyStateCode String? @map("place_of_supply_state_code") @db.VarChar(2)
  sellerStateCode        String? @map("seller_state_code") @db.VarChar(2)
  isInterState           Boolean @default(false) @map("is_inter_state")

  subtotal       Decimal @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  cgstAmount     Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount     Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount     Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  grandTotal     Decimal @default(0) @map("grand_total") @db.Decimal(14, 2)

  amountPaid     Decimal @default(0) @map("amount_paid") @db.Decimal(14, 2)
  amountCredited Decimal @default(0) @map("amount_credited") @db.Decimal(14, 2)

  notes String? @db.VarChar(1000)

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer   Party       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  dispatch   Dispatch?   @relation("InvoiceDispatch", fields: [dispatchId], references: [id], onDelete: Restrict)
  createdBy  User?       @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items            SalesInvoiceItem[]
  receipts         Receipt[]
  salesReturns     SalesReturn[]
  dispatchesBilled Dispatch[]              @relation("DispatchInvoice")
  ledgerEntries    ReceivableLedgerEntry[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, customerId])
  @@index([tenantId, paymentStatus, deletedAt])
  @@index([tenantId, dueDate])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  salesInvoiceId String @map("sales_invoice_id") @db.Uuid

  lineNumber Int @map("line_number")

  itemId  String @map("item_id") @db.Uuid
  batchId String @map("batch_id") @db.Uuid

  description String   @db.VarChar(500)
  hsnCode     String?  @map("hsn_code") @db.VarChar(16)
  batchNumber String   @map("batch_number") @db.VarChar(32)
  expiryDate  DateTime @map("expiry_date") @db.Date
  mrp         Decimal? @db.Decimal(14, 2)

  quantity       Decimal @db.Decimal(14, 3)
  unitPrice      Decimal @map("unit_price") @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxableValue   Decimal @default(0) @map("taxable_value") @db.Decimal(14, 2)
  gstRatePercent Decimal @default(0) @map("gst_rate_percent") @db.Decimal(5, 2)
  cgstAmount     Decimal @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount     Decimal @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount     Decimal @default(0) @map("igst_amount") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  lineTotal      Decimal @default(0) @map("line_total") @db.Decimal(14, 2)

  /// The DPCO/NLEM ceiling as at invoice time, when one applied.
  ceilingPriceAtInvoice Decimal? @map("ceiling_price_at_invoice") @db.Decimal(14, 2)

  quantityReturned Decimal @default(0) @map("quantity_returned") @db.Decimal(14, 3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch        Batch        @relation(fields: [batchId], references: [id], onDelete: Restrict)

  returnItems SalesReturnItem[]

  @@unique([salesInvoiceId, lineNumber])
  @@index([tenantId, itemId])
  @@index([salesInvoiceId])
  @@map("sales_invoice_items")
}

model Receipt {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  receiptNumber String @map("receipt_number") @db.VarChar(32)

  customerId     String @map("customer_id") @db.Uuid
  salesInvoiceId String @map("sales_invoice_id") @db.Uuid

  receiptDate DateTime @map("receipt_date") @db.Date
  amount      Decimal  @db.Decimal(14, 2)

  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number") @db.VarChar(64)

  status ReceiptStatus @default(RECORDED)

  notes String? @db.VarChar(1000)

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer     Party        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  ledgerEntries ReceivableLedgerEntry[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, salesInvoiceId])
  @@index([tenantId, customerId])
  @@map("receipts")
}

model SalesReturn {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  returnNumber String @map("return_number") @db.VarChar(32)

  customerId     String  @map("customer_id") @db.Uuid
  salesInvoiceId String  @map("sales_invoice_id") @db.Uuid
  salesOrderId   String? @map("sales_order_id") @db.Uuid

  returnDate  DateTime     @map("return_date") @db.Date
  reason      ReturnReason
  reasonNotes String?      @map("reason_notes") @db.VarChar(1000)

  status SalesReturnStatus @default(DRAFT)

  subtotal    Decimal @default(0) @db.Decimal(14, 2)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  totalAmount Decimal @default(0) @map("total_amount") @db.Decimal(14, 2)

  notes String? @db.VarChar(1000)

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer     Party        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  salesOrder   SalesOrder?  @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  createdBy    User?        @relation("ReturnCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  items         SalesReturnItem[]
  ledgerEntries ReceivableLedgerEntry[]

  @@unique([tenantId, returnNumber])
  @@index([tenantId, salesInvoiceId])
  @@index([tenantId, customerId])
  @@index([tenantId, status, deletedAt])
  @@map("sales_returns")
}

model SalesReturnItem {
  id            String @id @default(uuid()) @db.Uuid
  tenantId      String @map("tenant_id") @db.Uuid
  salesReturnId String @map("sales_return_id") @db.Uuid

  salesInvoiceItemId String @map("sales_invoice_item_id") @db.Uuid
  itemId             String @map("item_id") @db.Uuid
  batchId            String @map("batch_id") @db.Uuid

  quantity       Decimal @db.Decimal(14, 3)
  unitPrice      Decimal @map("unit_price") @db.Decimal(14, 2)
  gstRatePercent Decimal @default(0) @map("gst_rate_percent") @db.Decimal(5, 2)
  taxableValue   Decimal @default(0) @map("taxable_value") @db.Decimal(14, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  amount         Decimal @default(0) @db.Decimal(14, 2)

  reason      ReturnReason
  disposition ReturnedStockDisposition @default(QUARANTINE)

  notes String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  salesReturn      SalesReturn      @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  salesInvoiceItem SalesInvoiceItem @relation(fields: [salesInvoiceItemId], references: [id], onDelete: Restrict)
  item             Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch            Batch            @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([salesReturnId])
  @@index([salesInvoiceItemId])
  @@index([tenantId])
  @@map("sales_return_items")
}

/// Append-only. The outstanding balance is the running sum, so it can be
/// explained line by line rather than asserted by a cached column.
model ReceivableLedgerEntry {
  id       BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid

  customerId String @map("customer_id") @db.Uuid

  entryType ReceivableEntryType @map("entry_type")
  direction ReceivableDirection
  amount    Decimal             @db.Decimal(14, 2)

  salesInvoiceId String? @map("sales_invoice_id") @db.Uuid
  receiptId      String? @map("receipt_id") @db.Uuid
  salesReturnId  String? @map("sales_return_id") @db.Uuid

  notes String? @db.VarChar(1000)

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer     Party         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  receipt      Receipt?      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  salesReturn  SalesReturn?  @relation(fields: [salesReturnId], references: [id], onDelete: Restrict)
  createdBy    User?         @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, salesInvoiceId])
  @@map("receivable_ledger_entries")
}
